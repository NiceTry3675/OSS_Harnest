[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4333605998", "html_url": "https://github.com/NousResearch/hermes-agent/issues/15291#issuecomment-4333605998", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/15291", "id": 4333605998, "node_id": "IC_kwDOPRF1G88AAAABAk2Ubg", "user": {"login": "cyancorp", "id": 202313869, "node_id": "U_kgDODA8QjQ", "avatar_url": "https://avatars.githubusercontent.com/u/202313869?v=4", "gravatar_id": "", "url": "https://api.github.com/users/cyancorp", "html_url": "https://github.com/cyancorp", "followers_url": "https://api.github.com/users/cyancorp/followers", "following_url": "https://api.github.com/users/cyancorp/following{/other_user}", "gists_url": "https://api.github.com/users/cyancorp/gists{/gist_id}", "starred_url": "https://api.github.com/users/cyancorp/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/cyancorp/subscriptions", "organizations_url": "https://api.github.com/users/cyancorp/orgs", "repos_url": "https://api.github.com/users/cyancorp/repos", "events_url": "https://api.github.com/users/cyancorp/events{/privacy}", "received_events_url": "https://api.github.com/users/cyancorp/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-28T08:32:50Z", "updated_at": "2026-04-28T08:32:50Z", "body": "Same, I get the \"You're out of extra usage\" error after turning off extra usage. ", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4333605998/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4529048231", "html_url": "https://github.com/NousResearch/hermes-agent/issues/15291#issuecomment-4529048231", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/15291", "id": 4529048231, "node_id": "IC_kwDOPRF1G88AAAABDfPKpw", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-24T14:43:34Z", "updated_at": "2026-05-24T14:43:34Z", "body": "Closing \u2014 this is intended behavior from Anthropic's side, not a bug we can fix.\n\nAnthropic forces the `mcp_` tool-name prefix as the only pathway through which OAuth subscription tokens (Pro/Max) can access tools at all. The subscription-token tool access they allow is metered against the overage/extra-usage bucket exclusively \u2014 there is no \"included quota\" path for tools on OAuth subscriptions. Removing the prefix doesn't unlock the included quota; it would block all tool-bearing requests on subscription tokens entirely.\n\nThe trade-off is intentional: keep the prefix and have tools work for users who have overage enabled (or pay-per-use), or drop the prefix and break tools for every OAuth subscription user. We chose the former.\n\nFor Max/Pro subscribers without overage enabled: use an API key instead of the OAuth subscription token, or enable usage-based billing on your Anthropic account.\n\nTracking issue: #28849.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4529048231/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
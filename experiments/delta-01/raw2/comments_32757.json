[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4547513430", "html_url": "https://github.com/NousResearch/hermes-agent/issues/32757#issuecomment-4547513430", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/32757", "id": 4547513430, "node_id": "IC_kwDOPRF1G88AAAABDw2MVg", "user": {"login": "alt-glitch", "id": 52913345, "node_id": "MDQ6VXNlcjUyOTEzMzQ1", "avatar_url": "https://avatars.githubusercontent.com/u/52913345?v=4", "gravatar_id": "", "url": "https://api.github.com/users/alt-glitch", "html_url": "https://github.com/alt-glitch", "followers_url": "https://api.github.com/users/alt-glitch/followers", "following_url": "https://api.github.com/users/alt-glitch/following{/other_user}", "gists_url": "https://api.github.com/users/alt-glitch/gists{/gist_id}", "starred_url": "https://api.github.com/users/alt-glitch/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/alt-glitch/subscriptions", "organizations_url": "https://api.github.com/users/alt-glitch/orgs", "repos_url": "https://api.github.com/users/alt-glitch/repos", "events_url": "https://api.github.com/users/alt-glitch/events{/privacy}", "received_events_url": "https://api.github.com/users/alt-glitch/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-26T18:44:10Z", "updated_at": "2026-05-26T18:44:10Z", "body": "Related: #17247 adds `provider_routing.zdr` support for OpenRouter Zero Data Retention routing, which would address the `data_collection: \"deny\"` passthrough when using Nous Portal.\n\nThe core issue is that `provider_routing` config is an OpenRouter-specific feature and doesn't currently pass through the Nous Portal inference proxy. The question about Nous's own data practices is a policy/ToS question outside hermes-agent scope.\n", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4547513430/reactions", "total_count": 2, "+1": 2, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4959023957", "html_url": "https://github.com/NousResearch/hermes-agent/issues/32757#issuecomment-4959023957", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/32757", "id": 4959023957, "node_id": "IC_kwDOPRF1G88AAAABJ5SzVQ", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-13T14:26:51Z", "updated_at": "2026-07-13T14:26:51Z", "body": "<!-- hermes-sweeper:item=32757 -->\n<!-- hermes-sweeper:verdict=close reason=implemented_on_main confidence=high -->\nThanks for the clear reproduction. This is now implemented on `main` by the provider-routing passthrough fix.\n\nAutomated hermes-sweeper review verified:\n- `3aeaf3755d1437d50519dec6c7b1a839f8773c40` (`fix(nous): forward provider routing through Portal`) added Nous Portal forwarding for provider preferences.\n- `agent/chat_completion_helpers.py:181-182` builds `data_collection` from `provider_routing.data_collection`.\n- `plugins/model-providers/nous/__init__.py:16-20` places those preferences in the outgoing `extra_body.provider` request object.\n- `tests/providers/test_transport_parity.py:211-224` covers that Nous requests retain provider preferences, and the current provider-routing documentation describes Nous Portal support.\n\nThe separate question about Nous Portal's own terms/data practices remains a Portal policy question rather than Hermes-Agent behavior.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4959023957/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
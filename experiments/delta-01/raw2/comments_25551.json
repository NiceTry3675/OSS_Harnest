[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4449055582", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25551#issuecomment-4449055582", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25551", "id": 4449055582, "node_id": "IC_kwDOPRF1G88AAAABCS8zXg", "user": {"login": "alt-glitch", "id": 52913345, "node_id": "MDQ6VXNlcjUyOTEzMzQ1", "avatar_url": "https://avatars.githubusercontent.com/u/52913345?v=4", "gravatar_id": "", "url": "https://api.github.com/users/alt-glitch", "html_url": "https://github.com/alt-glitch", "followers_url": "https://api.github.com/users/alt-glitch/followers", "following_url": "https://api.github.com/users/alt-glitch/following{/other_user}", "gists_url": "https://api.github.com/users/alt-glitch/gists{/gist_id}", "starred_url": "https://api.github.com/users/alt-glitch/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/alt-glitch/subscriptions", "organizations_url": "https://api.github.com/users/alt-glitch/orgs", "repos_url": "https://api.github.com/users/alt-glitch/repos", "events_url": "https://api.github.com/users/alt-glitch/events{/privacy}", "received_events_url": "https://api.github.com/users/alt-glitch/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-14T08:34:48Z", "updated_at": "2026-05-14T08:34:48Z", "body": "Related to #24424 (Windows native install failure when Python not pre-installed). Root cause here appears to be uv failing to download Python 3.11 on a fresh Windows install, then pywinpty build failure when uv picks up Python 3.14 during sync. PR #25555 may address the version pinning aspect.\n", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4449055582/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4449139505", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25551#issuecomment-4449139505", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25551", "id": 4449139505, "node_id": "IC_kwDOPRF1G88AAAABCTB7MQ", "user": {"login": "SoftologyPro", "id": 47686889, "node_id": "MDQ6VXNlcjQ3Njg2ODg5", "avatar_url": "https://avatars.githubusercontent.com/u/47686889?v=4", "gravatar_id": "", "url": "https://api.github.com/users/SoftologyPro", "html_url": "https://github.com/SoftologyPro", "followers_url": "https://api.github.com/users/SoftologyPro/followers", "following_url": "https://api.github.com/users/SoftologyPro/following{/other_user}", "gists_url": "https://api.github.com/users/SoftologyPro/gists{/gist_id}", "starred_url": "https://api.github.com/users/SoftologyPro/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/SoftologyPro/subscriptions", "organizations_url": "https://api.github.com/users/SoftologyPro/orgs", "repos_url": "https://api.github.com/users/SoftologyPro/repos", "events_url": "https://api.github.com/users/SoftologyPro/events{/privacy}", "received_events_url": "https://api.github.com/users/SoftologyPro/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-14T08:47:50Z", "updated_at": "2026-05-14T08:48:29Z", "body": "In my case Python is pre-installed v3.10.11 and works with other AI scripts/systems.\nI do use the same version on the other PCs the Hermes install worked on.  Something on this fresh install is causing the problem.\nWhat do I need to change in the install.ps1 file to test the fix?  I can run a test fix version here to see if it can solve the problem.\n\nThe fix states\nPass --python $PythonVersion to all uv sync and uv pip install calls in install.ps1 so the Python version negotiated during Test-Python is consistently used throughout the install.\n\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4449139505/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4455353249", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25551#issuecomment-4455353249", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25551", "id": 4455353249, "node_id": "IC_kwDOPRF1G88AAAABCY9LoQ", "user": {"login": "SoftologyPro", "id": 47686889, "node_id": "MDQ6VXNlcjQ3Njg2ODg5", "avatar_url": "https://avatars.githubusercontent.com/u/47686889?v=4", "gravatar_id": "", "url": "https://api.github.com/users/SoftologyPro", "html_url": "https://github.com/SoftologyPro", "followers_url": "https://api.github.com/users/SoftologyPro/followers", "following_url": "https://api.github.com/users/SoftologyPro/following{/other_user}", "gists_url": "https://api.github.com/users/SoftologyPro/gists{/gist_id}", "starred_url": "https://api.github.com/users/SoftologyPro/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/SoftologyPro/subscriptions", "organizations_url": "https://api.github.com/users/SoftologyPro/orgs", "repos_url": "https://api.github.com/users/SoftologyPro/repos", "events_url": "https://api.github.com/users/SoftologyPro/events{/privacy}", "received_events_url": "https://api.github.com/users/SoftologyPro/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-14T22:49:12Z", "updated_at": "2026-05-14T23:23:47Z", "body": "I installed the Hermes desktop UI\nhttps://github.com/fathah/hermes-desktop\nand saw the same errors during it's install of the agent.\nBut, when it finished installing the UI opens and runs fine.\nThe desktop UI install fixes the problem somehow.\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4455353249/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4455751861", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25551#issuecomment-4455751861", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25551", "id": 4455751861, "node_id": "IC_kwDOPRF1G88AAAABCZVgtQ", "user": {"login": "SoftologyPro", "id": 47686889, "node_id": "MDQ6VXNlcjQ3Njg2ODg5", "avatar_url": "https://avatars.githubusercontent.com/u/47686889?v=4", "gravatar_id": "", "url": "https://api.github.com/users/SoftologyPro", "html_url": "https://github.com/SoftologyPro", "followers_url": "https://api.github.com/users/SoftologyPro/followers", "following_url": "https://api.github.com/users/SoftologyPro/following{/other_user}", "gists_url": "https://api.github.com/users/SoftologyPro/gists{/gist_id}", "starred_url": "https://api.github.com/users/SoftologyPro/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/SoftologyPro/subscriptions", "organizations_url": "https://api.github.com/users/SoftologyPro/orgs", "repos_url": "https://api.github.com/users/SoftologyPro/repos", "events_url": "https://api.github.com/users/SoftologyPro/events{/privacy}", "received_events_url": "https://api.github.com/users/SoftologyPro/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-15T00:15:16Z", "updated_at": "2026-05-15T00:15:16Z", "body": "Another find.  Once I uninstall the UI agent from Control Panel and remove the following directories...\n\nrd %LOCALAPPDATA%\\hermes /s/q\nrd %LOCALAPPDATA%\\puccinialin /s/q\nrd %LOCALAPPDATA%\\uv /s/q\n\nThen when installing Hermes CLI again, it stilll gives the maturin error, but the install does continue and does report it finished OK.  I can then run the CLI on a command line fine again.\n\nMaybe that helps?  Maybe not.  At least I have Hermes working again and have a more robust uninstall when something goes wrong.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4455751861/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4688105074", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25551#issuecomment-4688105074", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25551", "id": 4688105074, "node_id": "IC_kwDOPRF1G88AAAABF27Ocg", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-12T06:32:50Z", "updated_at": "2026-06-12T06:32:50Z", "body": "<!-- hermes-sweeper:item=25551 -->\n<!-- hermes-sweeper:verdict=close reason=implemented_on_main confidence=high -->\nThis looks implemented on current `main`. Automated hermes-sweeper review found targeted fixes for both failure modes in the Windows install log.\n\n- `scripts/install.ps1:443` now relaxes PowerShell `ErrorActionPreference` while running `uv python install`, so uv's normal download progress on stderr no longer gets treated as an install failure. This was added in `622c27e55c58a0d11739a21ae29dd6d072230cf0`.\n- `scripts/install.ps1:1423` and `scripts/install.ps1:1453` now pin later uv stages to the venv interpreter via `UV_PYTHON`, including across separate desktop/bootstrap stage processes, preventing uv from switching to Python 3.14 and hitting the pywinpty/PyO3 maturin build failure.\n- `pyproject.toml:13` now caps project Python support at `<3.14` with an inline note for the same Rust-backed transitive / cp314 wheel failure mode.\n- The complete Python 3.14 / `UV_PYTHON` fix is in `475ecea3d75784d2c1d98279d63ae4e5fba5d497`, contained in release tag `v2026.6.5`.\n\nClosing as implemented on main by automated hermes-sweeper review.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4688105074/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
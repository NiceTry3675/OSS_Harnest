[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4314972080", "html_url": "https://github.com/NousResearch/hermes-agent/issues/14980#issuecomment-4314972080", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/14980", "id": 4314972080, "node_id": "IC_kwDOPRF1G88AAAABATE_sA", "user": {"login": "MageInt", "id": 141229711, "node_id": "U_kgDOCGr-jw", "avatar_url": "https://avatars.githubusercontent.com/u/141229711?v=4", "gravatar_id": "", "url": "https://api.github.com/users/MageInt", "html_url": "https://github.com/MageInt", "followers_url": "https://api.github.com/users/MageInt/followers", "following_url": "https://api.github.com/users/MageInt/following{/other_user}", "gists_url": "https://api.github.com/users/MageInt/gists{/gist_id}", "starred_url": "https://api.github.com/users/MageInt/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/MageInt/subscriptions", "organizations_url": "https://api.github.com/users/MageInt/orgs", "repos_url": "https://api.github.com/users/MageInt/repos", "events_url": "https://api.github.com/users/MageInt/events{/privacy}", "received_events_url": "https://api.github.com/users/MageInt/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-24T17:11:23Z", "updated_at": "2026-04-24T17:11:23Z", "body": "I have the same issue, but my NAS is powerful and connected to internet with a 10Gb/s connection.\n\nI'm using the latest docker image (sha256:1ec03a06df35898215e826fbe5a6a2d29b8942d24aec47d1a0a7e9f097e97370).\n\n_[Whatsapp] Installing WhatsApp bridge dependencies...\n[Whatsapp] npm install failed: \nWARNING gateway.run: \u2717 whatsapp failed to connect\n[Whatsapp] Disconnecting (external bridge left running)\n[Whatsapp] Disconnected\nERROR gateway.run: Gateway failed to connect any configured messaging platform: whatsapp: failed to connect_\n\n\nI did the following test :\n\nFor keep the container alive, in the stack, I changed the command: gateway run with command: sleep infinity\n\n```\ndocker exec -it hermes /bin/bash\ncd /opt/hermes/scripts/whatsapp-bridge/\nnpm install --unsafe-perm\n\nadded 146 packages, and audited 147 packages in 2m\n```\n\nAs you can see the the npm install did succeed, but took 2 min for complete.\n\n\n\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4314972080/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4320040720", "html_url": "https://github.com/NousResearch/hermes-agent/issues/14980#issuecomment-4320040720", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/14980", "id": 4320040720, "node_id": "IC_kwDOPRF1G88AAAABAX6XEA", "user": {"login": "DFP-", "id": 1736079, "node_id": "MDQ6VXNlcjE3MzYwNzk=", "avatar_url": "https://avatars.githubusercontent.com/u/1736079?v=4", "gravatar_id": "", "url": "https://api.github.com/users/DFP-", "html_url": "https://github.com/DFP-", "followers_url": "https://api.github.com/users/DFP-/followers", "following_url": "https://api.github.com/users/DFP-/following{/other_user}", "gists_url": "https://api.github.com/users/DFP-/gists{/gist_id}", "starred_url": "https://api.github.com/users/DFP-/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/DFP-/subscriptions", "organizations_url": "https://api.github.com/users/DFP-/orgs", "repos_url": "https://api.github.com/users/DFP-/repos", "events_url": "https://api.github.com/users/DFP-/events{/privacy}", "received_events_url": "https://api.github.com/users/DFP-/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-25T16:18:27Z", "updated_at": "2026-04-25T16:18:27Z", "body": "Also seeing this on a debian VM, is there a local workaround, tried a few workarounds like the sleep infinity method MageInt mentioned + having the dashboard with the healthcheck try restarting the agent from the recommended dashboard/agent compose file combo, but no dice.  Is there any way to get whatsapp working on a fresh container install?", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4320040720/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4353474470", "html_url": "https://github.com/NousResearch/hermes-agent/issues/14980#issuecomment-4353474470", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/14980", "id": 4353474470, "node_id": "IC_kwDOPRF1G88AAAABA3y_pg", "user": {"login": "lloesche", "id": 2124094, "node_id": "MDQ6VXNlcjIxMjQwOTQ=", "avatar_url": "https://avatars.githubusercontent.com/u/2124094?v=4", "gravatar_id": "", "url": "https://api.github.com/users/lloesche", "html_url": "https://github.com/lloesche", "followers_url": "https://api.github.com/users/lloesche/followers", "following_url": "https://api.github.com/users/lloesche/following{/other_user}", "gists_url": "https://api.github.com/users/lloesche/gists{/gist_id}", "starred_url": "https://api.github.com/users/lloesche/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/lloesche/subscriptions", "organizations_url": "https://api.github.com/users/lloesche/orgs", "repos_url": "https://api.github.com/users/lloesche/repos", "events_url": "https://api.github.com/users/lloesche/events{/privacy}", "received_events_url": "https://api.github.com/users/lloesche/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-30T14:48:40Z", "updated_at": "2026-04-30T14:48:40Z", "body": "Can confirm. Running hermes with Whatsapp in Docker downloads the packages on every start and times out every time. When run directly after the setup the Whatsapp bridge works just fine.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4353474470/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4465043772", "html_url": "https://github.com/NousResearch/hermes-agent/issues/14980#issuecomment-4465043772", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/14980", "id": 4465043772, "node_id": "IC_kwDOPRF1G88AAAABCiMpPA", "user": {"login": "dryas", "id": 94088, "node_id": "MDQ6VXNlcjk0MDg4", "avatar_url": "https://avatars.githubusercontent.com/u/94088?v=4", "gravatar_id": "", "url": "https://api.github.com/users/dryas", "html_url": "https://github.com/dryas", "followers_url": "https://api.github.com/users/dryas/followers", "following_url": "https://api.github.com/users/dryas/following{/other_user}", "gists_url": "https://api.github.com/users/dryas/gists{/gist_id}", "starred_url": "https://api.github.com/users/dryas/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/dryas/subscriptions", "organizations_url": "https://api.github.com/users/dryas/orgs", "repos_url": "https://api.github.com/users/dryas/repos", "events_url": "https://api.github.com/users/dryas/events{/privacy}", "received_events_url": "https://api.github.com/users/dryas/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-16T01:47:37Z", "updated_at": "2026-05-16T01:49:27Z", "body": "Can confirm, the Whatsapp bridge gets newly installed each time I start the container and times out (even with 300 seconds timeout).\n\n```\n[Whatsapp] Installing WhatsApp bridge dependencies...\n[Whatsapp] Failed to install dependencies: Command '['/usr/bin/npm', 'install', '--silent']' timed out after 300 seconds\nWARNING gateway.run: \u2717 whatsapp failed to connect\n[Whatsapp] Disconnecting (external bridge left running)\n[Whatsapp] Disconnected\n[Whatsapp] Bridge process died (exit code 1)\n[Whatsapp] Check log: /opt/data/whatsapp/bridge.log\n```", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4465043772/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4465440749", "html_url": "https://github.com/NousResearch/hermes-agent/issues/14980#issuecomment-4465440749", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/14980", "id": 4465440749, "node_id": "IC_kwDOPRF1G88AAAABCik37Q", "user": {"login": "konsisumer", "id": 11262660, "node_id": "MDQ6VXNlcjExMjYyNjYw", "avatar_url": "https://avatars.githubusercontent.com/u/11262660?v=4", "gravatar_id": "", "url": "https://api.github.com/users/konsisumer", "html_url": "https://github.com/konsisumer", "followers_url": "https://api.github.com/users/konsisumer/followers", "following_url": "https://api.github.com/users/konsisumer/following{/other_user}", "gists_url": "https://api.github.com/users/konsisumer/gists{/gist_id}", "starred_url": "https://api.github.com/users/konsisumer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/konsisumer/subscriptions", "organizations_url": "https://api.github.com/users/konsisumer/orgs", "repos_url": "https://api.github.com/users/konsisumer/repos", "events_url": "https://api.github.com/users/konsisumer/events{/privacy}", "received_events_url": "https://api.github.com/users/konsisumer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-16T03:47:03Z", "updated_at": "2026-05-16T03:47:03Z", "body": "Thanks for the detailed reports \u2014 sharing where this stands and a few diagnostic asks so we can confirm a path forward.\n\n**Status:** On `main`, the WhatsApp bridge `npm install` timeout is now 300s by default and configurable via the `WHATSAPP_NPM_INSTALL_TIMEOUT` env var (in seconds; e.g. `WHATSAPP_NPM_INSTALL_TIMEOUT=900` for 15 minutes). However, @dryas's report above shows 300s isn't always enough, and several of you note the bridge re-installs dependencies on **every** container start \u2014 that's a separate root cause (the Docker image isn't pre-baking `scripts/whatsapp-bridge/node_modules`, so the runtime install fires every boot).\n\nTo triage further, could affected reporters share:\n\n1. The exact Hermes version inside the container (`docker exec <container> hermes --version`) so we can confirm the timeout fix is present.\n2. Whether `WHATSAPP_NPM_INSTALL_TIMEOUT=900` in your compose env unblocks startup, or whether it still times out at the higher ceiling.\n3. Output of `docker exec <container> ls /opt/hermes/scripts/whatsapp-bridge/node_modules 2>&1 | head -5` immediately after a fresh container start \u2014 this confirms whether `node_modules` is missing on every boot.\n4. Whether `/opt/hermes/scripts/whatsapp-bridge/` is on a bind-mount or named volume in your compose file (vs. only inside the image layer).\n5. Approximate duration of a successful manual `npm install` inside the container \u2014 @MageInt reported ~2 minutes above; a few more data points on slower NAS hardware would help calibrate the default.\n\n<!-- autocontrib:worker-id=issue-new-65b40081 kind=clarification -->", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4465440749/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4902380705", "html_url": "https://github.com/NousResearch/hermes-agent/issues/14980#issuecomment-4902380705", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/14980", "id": 4902380705, "node_id": "IC_kwDOPRF1G88AAAABJDRkoQ", "user": {"login": "kshitijk4poor", "id": 82637225, "node_id": "MDQ6VXNlcjgyNjM3MjI1", "avatar_url": "https://avatars.githubusercontent.com/u/82637225?v=4", "gravatar_id": "", "url": "https://api.github.com/users/kshitijk4poor", "html_url": "https://github.com/kshitijk4poor", "followers_url": "https://api.github.com/users/kshitijk4poor/followers", "following_url": "https://api.github.com/users/kshitijk4poor/following{/other_user}", "gists_url": "https://api.github.com/users/kshitijk4poor/gists{/gist_id}", "starred_url": "https://api.github.com/users/kshitijk4poor/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/kshitijk4poor/subscriptions", "organizations_url": "https://api.github.com/users/kshitijk4poor/orgs", "repos_url": "https://api.github.com/users/kshitijk4poor/repos", "events_url": "https://api.github.com/users/kshitijk4poor/events{/privacy}", "received_events_url": "https://api.github.com/users/kshitijk4poor/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-07T09:42:03Z", "updated_at": "2026-07-07T09:42:03Z", "body": "Fixed on current main: the npm install timeout in the WhatsApp bridge now defaults to **300s** and is configurable via `WHATSAPP_NPM_INSTALL_TIMEOUT` \u2014 exactly the suggested fix.\n\n`plugins/platforms/whatsapp/adapter.py:544`:\n```python\n# Read timeout from environment variable, default to 300 seconds (5 minutes)\n# to accommodate slower systems like Unraid NAS\nnpm_install_timeout = env_int(\"WHATSAPP_NPM_INSTALL_TIMEOUT\", 300)\n```\n\n(The adapter moved from `gateway/platforms/whatsapp.py` to `plugins/platforms/whatsapp/adapter.py` in the bundled-plugins migration.) Closing as implemented on main.", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4902380705/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-24T11:29:12Z", "updated_at": "2026-05-24T11:29:12Z", "body": "Closing as already fixed on `main`.\n\nTriage notes (high confidence):\nscripts/install.sh no longer has an interactive 'Install ripgrep / ffmpeg [Y/n]' prompt \u2014 ripgrep/ffmpeg are auto-installed via brew/apt/etc (lines 725-790). scripts/install.ps1 'Installing ripgrep and ffmpeg' stage is marked NeedsUserInput=$false (line 2078). Original hang scenario no longer reachable.\n\nIf you still see this on the latest version, please reopen with reproduction steps.\n\n(Bulk-closed during a CLI triage sweep.)", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4528378287/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4673129381", "html_url": "https://github.com/NousResearch/hermes-agent/issues/6147#issuecomment-4673129381", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/6147", "id": 4673129381, "node_id": "IC_kwDOPRF1G88AAAABFopLpQ", "user": {"login": "abes200", "id": 177388421, "node_id": "U_kgDOCpK7hQ", "avatar_url": "https://avatars.githubusercontent.com/u/177388421?v=4", "gravatar_id": "", "url": "https://api.github.com/users/abes200", "html_url": "https://github.com/abes200", "followers_url": "https://api.github.com/users/abes200/followers", "following_url": "https://api.github.com/users/abes200/following{/other_user}", "gists_url": "https://api.github.com/users/abes200/gists{/gist_id}", "starred_url": "https://api.github.com/users/abes200/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/abes200/subscriptions", "organizations_url": "https://api.github.com/users/abes200/orgs", "repos_url": "https://api.github.com/users/abes200/repos", "events_url": "https://api.github.com/users/abes200/events{/privacy}", "received_events_url": "https://api.github.com/users/abes200/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-10T18:19:30Z", "updated_at": "2026-06-10T18:19:30Z", "body": "Attempted install using desktop installer. It stalls at this point in the install, and the install window does not respond. I can simply close it by clicking the X in the corner, but 'Cancel' is unresponsive.\nNot sure how to reproduce this, or if its specific to my install and a conflict with something else I have installed.\nI simply downloaded the Hermes-Setup.exe file for windows and ran it. Not able to reopen issue.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4673129381/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4801899643", "html_url": "https://github.com/NousResearch/hermes-agent/issues/6147#issuecomment-4801899643", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/6147", "id": 4801899643, "node_id": "IC_kwDOPRF1G88AAAABHjcsew", "user": {"login": "jaredtrent", "id": 24501003, "node_id": "MDQ6VXNlcjI0NTAxMDAz", "avatar_url": "https://avatars.githubusercontent.com/u/24501003?v=4", "gravatar_id": "", "url": "https://api.github.com/users/jaredtrent", "html_url": "https://github.com/jaredtrent", "followers_url": "https://api.github.com/users/jaredtrent/followers", "following_url": "https://api.github.com/users/jaredtrent/following{/other_user}", "gists_url": "https://api.github.com/users/jaredtrent/gists{/gist_id}", "starred_url": "https://api.github.com/users/jaredtrent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/jaredtrent/subscriptions", "organizations_url": "https://api.github.com/users/jaredtrent/orgs", "repos_url": "https://api.github.com/users/jaredtrent/repos", "events_url": "https://api.github.com/users/jaredtrent/events{/privacy}", "received_events_url": "https://api.github.com/users/jaredtrent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-25T16:29:40Z", "updated_at": "2026-06-25T16:29:40Z", "body": "What I did to fix it on my system in powershell:\n\n1. Create install folder\n$installDir = \"$env:LOCALAPPDATA\\Programs\\hermes-tools\"; New-Item -ItemType Directory -Force -Path $installDir | Out-Null\n\n2. Download ripgrep\nInvoke-WebRequest -Uri \"https://github.com/BurntSushi/ripgrep/releases/download/14.1.1/ripgrep-14.1.1-x86_64-pc-windows-msvc.zip\" -OutFile \"$env:TEMP\\ripgrep.zip\" -UseBasicParsing\n\n3. Extract and install ripgrep\nExpand-Archive -Path \"$env:TEMP\\ripgrep.zip\" -DestinationPath \"$env:TEMP\\rg_extract\" -Force; Copy-Item \"$env:TEMP\\rg_extract\\ripgrep-14.1.1-x86_64-pc-windows-msvc\\rg.exe\" -Destination \"$installDir\\rg.exe\" -Force\n\n4. Download ffmpeg\nInvoke-WebRequest -Uri \"https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl-shared.zip\" -OutFile \"$env:TEMP\\ffmpeg.zip\" -UseBasicParsing\n\n5. Extract and install ffmpeg\nExpand-Archive -Path \"$env:TEMP\\ffmpeg.zip\" -DestinationPath \"$env:TEMP\\ff_extract\" -Force; $ffBinDir = (Get-ChildItem \"$env:TEMP\\ff_extract\" -Filter \"bin\" -Recurse -Directory | Select-Object -First 1).FullName; Copy-Item \"$ffBinDir\\*\" -Destination \"$installDir\" -Force\n\n6. Add to PATH\n$currentPath = [Environment]::GetEnvironmentVariable(\"PATH\", \"User\"); if ($currentPath -notlike \"*$installDir*\") { [Environment]::SetEnvironmentVariable(\"PATH\", \"$currentPath;$installDir\", \"User\") }\n\n7. Verify\nrg --version; ffmpeg -version\n\nThen open a new PowerShell window and re-run the Hermes install script.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4801899643/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4874942817", "html_url": "https://github.com/NousResearch/hermes-agent/issues/6147#issuecomment-4874942817", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/6147", "id": 4874942817, "node_id": "IC_kwDOPRF1G88AAAABIpG5YQ", "user": {"login": "frankssone1010", "id": 78664141, "node_id": "MDQ6VXNlcjc4NjY0MTQx", "avatar_url": "https://avatars.githubusercontent.com/u/78664141?v=4", "gravatar_id": "", "url": "https://api.github.com/users/frankssone1010", "html_url": "https://github.com/frankssone1010", "followers_url": "https://api.github.com/users/frankssone1010/followers", "following_url": "https://api.github.com/users/frankssone1010/following{/other_user}", "gists_url": "https://api.github.com/users/frankssone1010/gists{/gist_id}", "starred_url": "https://api.github.com/users/frankssone1010/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/frankssone1010/subscriptions", "organizations_url": "https://api.github.com/users/frankssone1010/orgs", "repos_url": "https://api.github.com/users/frankssone1010/repos", "events_url": "https://api.github.com/users/frankssone1010/events{/privacy}", "received_events_url": "https://api.github.com/users/frankssone1010/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-03T09:48:10Z", "updated_at": "2026-07-03T09:48:10Z", "body": "Open a terminal:\npip install ripgrep ffmpeg\n\nThen go to your hermes installation folder (C:\\Users\\YOUR_USERNAME\\AppData\\Local\\hermes) and open a terminal there:\ngit clone https://github.com/NousResearch/hermes-agent.git\n\nThen try running Hermes-Setup.exe again\n\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4874942817/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
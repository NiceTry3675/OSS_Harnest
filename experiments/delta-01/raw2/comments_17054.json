[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4338946013", "html_url": "https://github.com/NousResearch/hermes-agent/issues/17054#issuecomment-4338946013", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/17054", "id": 4338946013, "node_id": "IC_kwDOPRF1G88AAAABAp8P3Q", "user": {"login": "codexetreme", "id": 8681139, "node_id": "MDQ6VXNlcjg2ODExMzk=", "avatar_url": "https://avatars.githubusercontent.com/u/8681139?v=4", "gravatar_id": "", "url": "https://api.github.com/users/codexetreme", "html_url": "https://github.com/codexetreme", "followers_url": "https://api.github.com/users/codexetreme/followers", "following_url": "https://api.github.com/users/codexetreme/following{/other_user}", "gists_url": "https://api.github.com/users/codexetreme/gists{/gist_id}", "starred_url": "https://api.github.com/users/codexetreme/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/codexetreme/subscriptions", "organizations_url": "https://api.github.com/users/codexetreme/orgs", "repos_url": "https://api.github.com/users/codexetreme/repos", "events_url": "https://api.github.com/users/codexetreme/events{/privacy}", "received_events_url": "https://api.github.com/users/codexetreme/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-28T20:48:55Z", "updated_at": "2026-04-28T20:48:55Z", "body": "I figured it out ! \n\nthe generated manifest actually has /status (which is a restricted slack command and you can't use it )\n\nalso the alias reload_mcp can't be accepted , the underscores aren't allowed in a slash command", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4338946013/reactions", "total_count": 12, "+1": 10, "-1": 0, "laugh": 0, "hooray": 2, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4346882518", "html_url": "https://github.com/NousResearch/hermes-agent/issues/17054#issuecomment-4346882518", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/17054", "id": 4346882518, "node_id": "IC_kwDOPRF1G88AAAABAxgp1g", "user": {"login": "n", "id": 108156, "node_id": "MDQ6VXNlcjEwODE1Ng==", "avatar_url": "https://avatars.githubusercontent.com/u/108156?v=4", "gravatar_id": "", "url": "https://api.github.com/users/n", "html_url": "https://github.com/n", "followers_url": "https://api.github.com/users/n/followers", "following_url": "https://api.github.com/users/n/following{/other_user}", "gists_url": "https://api.github.com/users/n/gists{/gist_id}", "starred_url": "https://api.github.com/users/n/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/n/subscriptions", "organizations_url": "https://api.github.com/users/n/orgs", "repos_url": "https://api.github.com/users/n/repos", "events_url": "https://api.github.com/users/n/events{/privacy}", "received_events_url": "https://api.github.com/users/n/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-29T19:30:20Z", "updated_at": "2026-04-29T19:30:20Z", "body": "Additionally, I needed to add \"group:read\" to the bot scopes.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4346882518/reactions", "total_count": 4, "+1": 4, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4360110743", "html_url": "https://github.com/NousResearch/hermes-agent/issues/17054#issuecomment-4360110743", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/17054", "id": 4360110743, "node_id": "IC_kwDOPRF1G88AAAABA-IClw", "user": {"login": "omid-method", "id": 238513931, "node_id": "U_kgDODjdvCw", "avatar_url": "https://avatars.githubusercontent.com/u/238513931?v=4", "gravatar_id": "", "url": "https://api.github.com/users/omid-method", "html_url": "https://github.com/omid-method", "followers_url": "https://api.github.com/users/omid-method/followers", "following_url": "https://api.github.com/users/omid-method/following{/other_user}", "gists_url": "https://api.github.com/users/omid-method/gists{/gist_id}", "starred_url": "https://api.github.com/users/omid-method/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/omid-method/subscriptions", "organizations_url": "https://api.github.com/users/omid-method/orgs", "repos_url": "https://api.github.com/users/omid-method/repos", "events_url": "https://api.github.com/users/omid-method/events{/privacy}", "received_events_url": "https://api.github.com/users/omid-method/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-01T15:39:43Z", "updated_at": "2026-05-01T15:39:43Z", "body": "Verified this locally while setting up Slack Socket Mode on Ubuntu/WSL.\n\nThe generated manifest was rejected by Slack with `the slash command has an invalid name` at the `features.slash_commands` array. After narrowing it down by removing/re-adding commands, the offending command was `/status`.\n\nWorking local fix:\n- Rename the Slack manifest entry from `/status` to `/status1`.\n- Keep the internal Hermes command as `/status`.\n- Route incoming Slack `/status1` back to the existing internal `/status` handler.\n\nI re-added `/help` and `/reload_mcp` after testing; they were not the blocker in this workspace. So this issue is not only about punctuation/hyphen handling. `/status` appears to be reserved/rejected by Slack in at least this workspace.\r\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4360110743/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4414849797", "html_url": "https://github.com/NousResearch/hermes-agent/issues/17054#issuecomment-4414849797", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/17054", "id": 4414849797, "node_id": "IC_kwDOPRF1G88AAAABByVDBQ", "user": {"login": "steveisakson", "id": 37453065, "node_id": "MDQ6VXNlcjM3NDUzMDY1", "avatar_url": "https://avatars.githubusercontent.com/u/37453065?v=4", "gravatar_id": "", "url": "https://api.github.com/users/steveisakson", "html_url": "https://github.com/steveisakson", "followers_url": "https://api.github.com/users/steveisakson/followers", "following_url": "https://api.github.com/users/steveisakson/following{/other_user}", "gists_url": "https://api.github.com/users/steveisakson/gists{/gist_id}", "starred_url": "https://api.github.com/users/steveisakson/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/steveisakson/subscriptions", "organizations_url": "https://api.github.com/users/steveisakson/orgs", "repos_url": "https://api.github.com/users/steveisakson/repos", "events_url": "https://api.github.com/users/steveisakson/events{/privacy}", "received_events_url": "https://api.github.com/users/steveisakson/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-10T08:35:06Z", "updated_at": "2026-05-10T08:35:06Z", "body": "Also see this Reddit comment with screen shot with a broken manifest rejected by Slack: https://www.reddit.com/r/hermesagent/comments/1sgvy5s/comment/ojcq76m/", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4414849797/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4414986242", "html_url": "https://github.com/NousResearch/hermes-agent/issues/17054#issuecomment-4414986242", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/17054", "id": 4414986242, "node_id": "IC_kwDOPRF1G88AAAABBydYAg", "user": {"login": "konsisumer", "id": 11262660, "node_id": "MDQ6VXNlcjExMjYyNjYw", "avatar_url": "https://avatars.githubusercontent.com/u/11262660?v=4", "gravatar_id": "", "url": "https://api.github.com/users/konsisumer", "html_url": "https://github.com/konsisumer", "followers_url": "https://api.github.com/users/konsisumer/followers", "following_url": "https://api.github.com/users/konsisumer/following{/other_user}", "gists_url": "https://api.github.com/users/konsisumer/gists{/gist_id}", "starred_url": "https://api.github.com/users/konsisumer/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/konsisumer/subscriptions", "organizations_url": "https://api.github.com/users/konsisumer/orgs", "repos_url": "https://api.github.com/users/konsisumer/repos", "events_url": "https://api.github.com/users/konsisumer/events{/privacy}", "received_events_url": "https://api.github.com/users/konsisumer/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-10T09:48:14Z", "updated_at": "2026-05-10T09:48:14Z", "body": "Thanks for the additional report. The original `/status` rejection was fixed in https://github.com/NousResearch/hermes-agent/commit/a717199b (2026-05-01) \u2014 the Slack manifest generator now skips Slack-reserved commands (`/status`, `/me`, `/join`, \u2026) and the `groups:read` bot scope is already included.\n\nTo tell whether you're hitting a different problem or an older build, could you share:\n\n1. **Hermes version** \u2014 output of `hermes --version` (the fix is included in any build dated 2026-05-01 or later).\n2. **Exact Slack error** \u2014 the full text Slack shows when it rejects the manifest (e.g. \"the slash command has an invalid name\" plus any field path).\n3. **Generated manifest** \u2014 the JSON produced by `hermes slack manifest` against your install (or just the `features.slash_commands` array from `--slashes-only`).\n4. **Workspace plan** \u2014 Free / Pro / Business+ / Enterprise Grid; some reserved-name behavior differs by plan.\n\nIf you've already verified you're on a post-2026-05-01 build and Slack still rejects the manifest, that's a fresh bug and the diff above will let us reproduce it.\n\n<!-- autocontrib:worker-id=issue-new-07ef9232 kind=clarification -->", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4414986242/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4668602648", "html_url": "https://github.com/NousResearch/hermes-agent/issues/17054#issuecomment-4668602648", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/17054", "id": 4668602648, "node_id": "IC_kwDOPRF1G88AAAABFkU5GA", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-10T09:26:43Z", "updated_at": "2026-06-10T09:26:43Z", "body": "<!-- hermes-sweeper:item=17054 -->\n<!-- hermes-sweeper:verdict=close reason=implemented_on_main confidence=high -->\nThis looks fixed on current main.\n\nAutomated hermes-sweeper review evidence:\n\n- Commit `a717199bbf31a0900a99b06153d3ba5803cd9012` specifically fixes the reported Slack manifest failure by excluding Slack-reserved slash commands such as `/status`, while leaving them reachable through `/hermes <command>`.\n- `hermes_cli/commands.py:985` defines `_SLACK_RESERVED_COMMANDS`, including `status`, `me`, `join`, `topic`, and other Slack built-ins.\n- `hermes_cli/commands.py:1020` skips any generated Slack slash whose sanitized name is reserved.\n- `hermes_cli/slack_cli.py:77` includes the follow-up `groups:read` bot scope.\n- `tests/hermes_cli/test_commands.py:328` has regression coverage asserting reserved Slack commands do not appear in native Slack slashes.\n- A local generation check on current main showed `/status` absent, `/reload_mcp` absent, and `reserved_leaks=[]`.\n\nThe fix is contained in release tag `v2026.5.7` and later.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4668602648/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
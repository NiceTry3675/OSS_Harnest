es-agent/issues/5554", "id": 4210447276, "node_id": "IC_kwDOPRF1G8769lOs", "user": {"login": "Tsuki", "id": 9085560, "node_id": "MDQ6VXNlcjkwODU1NjA=", "avatar_url": "https://avatars.githubusercontent.com/u/9085560?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Tsuki", "html_url": "https://github.com/Tsuki", "followers_url": "https://api.github.com/users/Tsuki/followers", "following_url": "https://api.github.com/users/Tsuki/following{/other_user}", "gists_url": "https://api.github.com/users/Tsuki/gists{/gist_id}", "starred_url": "https://api.github.com/users/Tsuki/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Tsuki/subscriptions", "organizations_url": "https://api.github.com/users/Tsuki/orgs", "repos_url": "https://api.github.com/users/Tsuki/repos", "events_url": "https://api.github.com/users/Tsuki/events{/privacy}", "received_events_url": "https://api.github.com/users/Tsuki/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-08T23:43:40Z", "updated_at": "2026-04-08T23:43:40Z", "body": "i using orbstack can start with --platform linux/amd64\n```\ndocker run -d \\\n--name hermes --platform linux/amd64 \\\n--restart unless-stopped \\\n-v ~/.hermes:/opt/data \\\nnousresearch/hermes-agent:latest gateway run\n```", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4210447276/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4270008703", "html_url": "https://github.com/NousResearch/hermes-agent/issues/5554#issuecomment-4270008703", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/5554", "id": 4270008703, "node_id": "IC_kwDOPRF1G87-gyl_", "user": {"login": "p
[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188687905", "html_url": "https://github.com/NousResearch/hermes-agent/issues/5204#issuecomment-4188687905", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/5204", "id": 4188687905, "node_id": "IC_kwDOPRF1G875qk4h", "user": {"login": "ygd58", "id": 78954051, "node_id": "MDQ6VXNlcjc4OTU0MDUx", "avatar_url": "https://avatars.githubusercontent.com/u/78954051?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ygd58", "html_url": "https://github.com/ygd58", "followers_url": "https://api.github.com/users/ygd58/followers", "following_url": "https://api.github.com/users/ygd58/following{/other_user}", "gists_url": "https://api.github.com/users/ygd58/gists{/gist_id}", "starred_url": "https://api.github.com/users/ygd58/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ygd58/subscriptions", "organizations_url": "https://api.github.com/users/ygd58/orgs", "repos_url": "https://api.github.com/users/ygd58/repos", "events_url": "https://api.github.com/users/ygd58/events{/privacy}", "received_events_url": "https://api.github.com/users/ygd58/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-05T10:44:36Z", "updated_at": "2026-04-05T10:44:36Z", "body": "This is expected behavior \u2014 Hermes's delegation tool runs subagents sequentially, not in parallel. The \"delegate\" tool spawns one subagent at a time and waits for it to complete before the next one starts.\n\nTrue parallel multi-agent execution is not currently supported. The `/background` command can run a single agent in the background while you continue chatting, but coordinated parallel swarms are not implemented.\n\nIf you want to track this as a feature request rather than a bug, the label should be changed from \"bug\" to \"enhancement\".\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188687905/reactions", "total_count": 3, "+1": 2, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 1, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188711479", "html_url": "https://github.com/NousResearch/hermes-agent/issues/5204#issuecomment-4188711479", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/5204", "id": 4188711479, "node_id": "IC_kwDOPRF1G875qqo3", "user": {"login": "paciox", "id": 6546735, "node_id": "MDQ6VXNlcjY1NDY3MzU=", "avatar_url": "https://avatars.githubusercontent.com/u/6546735?v=4", "gravatar_id": "", "url": "https://api.github.com/users/paciox", "html_url": "https://github.com/paciox", "followers_url": "https://api.github.com/users/paciox/followers", "following_url": "https://api.github.com/users/paciox/following{/other_user}", "gists_url": "https://api.github.com/users/paciox/gists{/gist_id}", "starred_url": "https://api.github.com/users/paciox/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/paciox/subscriptions", "organizations_url": "https://api.github.com/users/paciox/orgs", "repos_url": "https://api.github.com/users/paciox/repos", "events_url": "https://api.github.com/users/paciox/events{/privacy}", "received_events_url": "https://api.github.com/users/paciox/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-05T11:04:56Z", "updated_at": "2026-04-05T11:04:56Z", "body": "> This is expected behavior \u2014 Hermes's delegation tool runs subagents sequentially, not in parallel. The \"delegate\" tool spawns one subagent at a time and waits for it to complete before the next one starts.\n> \n> True parallel multi-agent execution is not currently supported. The `/background` command can run a single agent in the background while you continue chatting, but coordinated parallel swarms are not implemented.\n> \n> If you want to track this as a feature request rather than a bug, the label should be changed from \"bug\" to \"enhancement\".\n\nThanks for the prompt reply!!!\nI didn't knew it and I couldn't figure out from documentation or main page of the project.\nChanged the label as you said. Can't figure out how to change the red label from bug to Enhancement", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188711479/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188716608", "html_url": "https://github.com/NousResearch/hermes-agent/issues/5204#issuecomment-4188716608", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/5204", "id": 4188716608, "node_id": "IC_kwDOPRF1G875qr5A", "user": {"login": "ygd58", "id": 78954051, "node_id": "MDQ6VXNlcjc4OTU0MDUx", "avatar_url": "https://avatars.githubusercontent.com/u/78954051?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ygd58", "html_url": "https://github.com/ygd58", "followers_url": "https://api.github.com/users/ygd58/followers", "following_url": "https://api.github.com/users/ygd58/following{/other_user}", "gists_url": "https://api.github.com/users/ygd58/gists{/gist_id}", "starred_url": "https://api.github.com/users/ygd58/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ygd58/subscriptions", "organizations_url": "https://api.github.com/users/ygd58/orgs", "repos_url": "https://api.github.com/users/ygd58/repos", "events_url": "https://api.github.com/users/ygd58/events{/privacy}", "received_events_url": "https://api.github.com/users/ygd58/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-05T11:09:15Z", "updated_at": "2026-04-05T11:09:15Z", "body": "No worries! To change the label: on the right side of the issue page, click \"Labels\" and uncheck \"bug\", then select \"enhancement\". Only repo maintainers or the issue author can do this.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188716608/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188786689", "html_url": "https://github.com/NousResearch/hermes-agent/issues/5204#issuecomment-4188786689", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/5204", "id": 4188786689, "node_id": "IC_kwDOPRF1G875q9AB", "user": {"login": "paciox", "id": 6546735, "node_id": "MDQ6VXNlcjY1NDY3MzU=", "avatar_url": "https://avatars.githubusercontent.com/u/6546735?v=4", "gravatar_id": "", "url": "https://api.github.com/users/paciox", "html_url": "https://github.com/paciox", "followers_url": "https://api.github.com/users/paciox/followers", "following_url": "https://api.github.com/users/paciox/following{/other_user}", "gists_url": "https://api.github.com/users/paciox/gists{/gist_id}", "starred_url": "https://api.github.com/users/paciox/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/paciox/subscriptions", "organizations_url": "https://api.github.com/users/paciox/orgs", "repos_url": "https://api.github.com/users/paciox/repos", "events_url": "https://api.github.com/users/paciox/events{/privacy}", "received_events_url": "https://api.github.com/users/paciox/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-05T12:05:27Z", "updated_at": "2026-04-05T12:05:27Z", "body": "/\n\n> No worries! To change the label: on the right side of the issue page, click \"Labels\" and uncheck \"bug\", then select \"enhancement\". Only repo maintainers or the issue author can do this.\n\nI have already tried my man. I tried all before reporting to you but I can't do it. I scanned the page for way to change it but can't find. Screenshot shows that it's static and I can't change  it. Better maybe close this and reopen as enhancement?\n\n<img width=\"1357\" height=\"664\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/c58809ac-2182-4cd3-b6b5-1c0de208e6f4\" />", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188786689/reactions", "total_count": 1, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 1, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188822857", "html_url": "https://github.com/NousResearch/hermes-agent/issues/5204#issuecomment-4188822857", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/5204", "id": 4188822857, "node_id": "IC_kwDOPRF1G875rF1J", "user": {"login": "ygd58", "id": 78954051, "node_id": "MDQ6VXNlcjc4OTU0MDUx", "avatar_url": "https://avatars.githubusercontent.com/u/78954051?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ygd58", "html_url": "https://github.com/ygd58", "followers_url": "https://api.github.com/users/ygd58/followers", "following_url": "https://api.github.com/users/ygd58/following{/other_user}", "gists_url": "https://api.github.com/users/ygd58/gists{/gist_id}", "starred_url": "https://api.github.com/users/ygd58/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ygd58/subscriptions", "organizations_url": "https://api.github.com/users/ygd58/orgs", "repos_url": "https://api.github.com/users/ygd58/repos", "events_url": "https://api.github.com/users/ygd58/events{/privacy}", "received_events_url": "https://api.github.com/users/ygd58/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-05T12:34:00Z", "updated_at": "2026-04-05T12:34:00Z", "body": "Only repo maintainers can change labels on others' issues. @teknium1 could you update this label to \"enhancement\"? Thanks!\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4188822857/reactions", "total_count": 2, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 1, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4950625315", "html_url": "https://github.com/NousResearch/hermes-agent/issues/5204#issuecomment-4950625315", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/5204", "id": 4950625315, "node_id": "IC_kwDOPRF1G88AAAABJxSMIw", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-12T09:06:22Z", "updated_at": "2026-07-12T09:06:22Z", "body": "<!-- hermes-sweeper:item=5204 -->\n<!-- hermes-sweeper:verdict=close reason=cannot_reproduce confidence=high -->\nThanks for reporting the confusing sequential behavior. This is now obsolete on current main; the earlier discussion accurately described the April release, but later delegation work added the requested fan-out and visibility.\n\nAutomated hermes-sweeper review verified:\n\n- `tools/delegate_tool.py:2529` submits batch children to a bounded thread pool, so a `tasks` array runs concurrently.\n- `run_agent.py:5694` dispatches top-level delegations in the background; batch responses explicitly report parallel subagents.\n- `website/docs/user-guide/features/delegation.md:122` documents parallel batches and real-time CLI tree-view progress.\n- Commit `ea8a8b4af` (`feat(delegation): background fan-out \u2014 parallel subagents, one consolidated return`) shipped in `v2026.7.1`.\n\nFor parallel work, use independent tasks in a delegation batch; the configured `delegation.max_concurrent_children` cap controls fan-out.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4950625315/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
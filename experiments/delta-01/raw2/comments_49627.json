[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4758643291", "html_url": "https://github.com/NousResearch/hermes-agent/issues/49627#issuecomment-4758643291", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/49627", "id": 4758643291, "node_id": "IC_kwDOPRF1G88AAAABG6MiWw", "user": {"login": "maxmilian", "id": 3001335, "node_id": "MDQ6VXNlcjMwMDEzMzU=", "avatar_url": "https://avatars.githubusercontent.com/u/3001335?v=4", "gravatar_id": "", "url": "https://api.github.com/users/maxmilian", "html_url": "https://github.com/maxmilian", "followers_url": "https://api.github.com/users/maxmilian/followers", "following_url": "https://api.github.com/users/maxmilian/following{/other_user}", "gists_url": "https://api.github.com/users/maxmilian/gists{/gist_id}", "starred_url": "https://api.github.com/users/maxmilian/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/maxmilian/subscriptions", "organizations_url": "https://api.github.com/users/maxmilian/orgs", "repos_url": "https://api.github.com/users/maxmilian/repos", "events_url": "https://api.github.com/users/maxmilian/events{/privacy}", "received_events_url": "https://api.github.com/users/maxmilian/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-20T15:03:40Z", "updated_at": "2026-06-20T15:03:40Z", "body": "This looks like a broken/partial install rather than a source bug. On current `main`, `init_agent()` in `agent/agent_init.py` accepts `event_callback`, and its caller in `run_agent.py` passes it \u2014 the two are in sync. They were added together atomically in commit `e76e7b50` (\"feat(hooks): session:compress event_callback for MemPalace sync\"), which touched both files in the same commit, so there was never a released state where the caller passed a kwarg the signature didn't accept.\n\nThat points to your installed tree being mismatched \u2014 e.g. `hermes update` updated `run_agent.py` but left an older `agent/agent_init.py` (or a stale `hermes-agent` package / `__pycache__` shadowing the new one). A clean reinstall should clear it:\n\n```\npip uninstall hermes-agent    # if installed as a package\n# then re-run the installer, or: find . -name __pycache__ -exec rm -rf {} +\n```\n\nIf it persists after a clean reinstall on the latest `main`, please reopen with the output of `hermes --version` and the full traceback (the exact unexpected kwarg name) and I'll take another look.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4758643291/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4763024189", "html_url": "https://github.com/NousResearch/hermes-agent/issues/49627#issuecomment-4763024189", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/49627", "id": 4763024189, "node_id": "IC_kwDOPRF1G88AAAABG-X7PQ", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-21T19:18:31Z", "updated_at": "2026-06-21T19:18:31Z", "body": "Closing as not reproducible on current `main` \u2014 verified the described root-cause mechanism is not present in current code (likely a stale/partial install). Reopen with repro steps on a clean latest install if it persists.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4763024189/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
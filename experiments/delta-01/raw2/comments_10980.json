repo}", "subscriptions_url": "https://api.github.com/users/Ethan-rookie/subscriptions", "organizations_url": "https://api.github.com/users/Ethan-rookie/orgs", "repos_url": "https://api.github.com/users/Ethan-rookie/repos", "events_url": "https://api.github.com/users/Ethan-rookie/events{/privacy}", "received_events_url": "https://api.github.com/users/Ethan-rookie/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-16T12:23:17Z", "updated_at": "2026-04-16T12:23:17Z", "body": "hermes update and it solves it.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4260016263/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4260661723", "html_url": "https://github.com/NousResearch/hermes-agent/issues/10980#issuecomment-4260661723", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/10980", "id": 4260661723, "node_id": "IC_kwDOPRF1G8799Inb", "user": {"login": "sashamorozov", "id": 4144548, "node_id": "MDQ6VXNlcjQxNDQ1NDg=", "avatar_url": "https://avatars.githubusercontent.com/u/4144548?v=4", "gravatar_id": "", "url": "https://api.github.com/users/sashamorozov", "html_url": "https://github.com/sashamorozov", "followers_url": "https://api.github.com/users/sashamorozov/followers", "following_url": "https://api.github.com/users/sashamorozov/following{/other_user}", "gists_url": "https://api.github.com/users/sashamorozov/gists{/gist_id}", "starred_url": "https://api.github.com/users/sashamorozov/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/sashamorozov/subscriptions", "organizations_url": "https://api.github.com/users/sashamorozov/orgs", "repos_url": "https://api.github.com/users/sashamorozov/repos", "events_url": "https://api.github.com/users/sashamorozov/events{/privacy}", "received_events_url": "https://api.github.com/users/sashamorozov/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-16T14:01:39Z", "updated_at": "2026-04-16T14:10:31Z", "body": "The regression shows up on the second message, not the first one.\n\n  In my case:\n  - the first message always succeeds\n  - the second message in the same conversation consistently fails with `APIConnectionError: Connection error`\n\n  This looks related to the keepalive / custom `http_client` change introduced in: https://github.com/NousResearch/hermes-agent/pull/10933\n\n  And it appears to be fixed by reverting: https://github.com/NousResearch/hermes-agent/commit/e07dbde582e6c80f80eb0d3040add8331832a87b\n\n  From debugging, this did not look like an auth problem.\n  Direct requests could still work, but repeated turns inside the same `AIAgent` instance broke.\n\n  It would also be really helpful to add regression tests for multi-turn conversations before shipping changes at this level.\n\n  A simple test where:\n  - first message succeeds\n  - second message in the same agent/session also succeeds would likely have caught this.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4260661723/reactions", "total_count": 2, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 1}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4260750221", "html_url": "https://github.com/NousResearch/hermes-agent/issues/10980#issuecomment-4260750221", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/10980", "id": 4260750221, "node_id": "IC_kwDOPRF1G8799eON", "user": {"login": "buaatian", "id": 16067009, "node_id": "MDQ6VXNlc
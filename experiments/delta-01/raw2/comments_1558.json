[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4068651048", "html_url": "https://github.com/NousResearch/hermes-agent/issues/1558#issuecomment-4068651048", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/1558", "id": 4068651048, "node_id": "IC_kwDOPRF1G87ygrAo", "user": {"login": "ygd58", "id": 78954051, "node_id": "MDQ6VXNlcjc4OTU0MDUx", "avatar_url": "https://avatars.githubusercontent.com/u/78954051?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ygd58", "html_url": "https://github.com/ygd58", "followers_url": "https://api.github.com/users/ygd58/followers", "following_url": "https://api.github.com/users/ygd58/following{/other_user}", "gists_url": "https://api.github.com/users/ygd58/gists{/gist_id}", "starred_url": "https://api.github.com/users/ygd58/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ygd58/subscriptions", "organizations_url": "https://api.github.com/users/ygd58/orgs", "repos_url": "https://api.github.com/users/ygd58/repos", "events_url": "https://api.github.com/users/ygd58/events{/privacy}", "received_events_url": "https://api.github.com/users/ygd58/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-16T15:46:09Z", "updated_at": "2026-03-16T15:46:09Z", "body": "Submitted a fix in PR #1562.\n\nThe fix adds two security checks to skill_view():\n\n1. **Untrusted path warning** \u2014 logs a warning if a skill file is loaded from outside ~/.hermes/skills/ (the trusted skills directory)\n2. **Injection pattern detection** \u2014 scans skill content for common prompt injection patterns (e.g. \"ignore previous instructions\", \"you are now\", \"<system>\") and logs a warning if detected\n\nBoth warnings are logged so they're visible in debug output without breaking normal skill functionality.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4068651048/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4069467716", "html_url": "https://github.com/NousResearch/hermes-agent/issues/1558#issuecomment-4069467716", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/1558", "id": 4069467716, "node_id": "IC_kwDOPRF1G87yjyZE", "user": {"login": "estebanavv", "id": 9424792, "node_id": "MDQ6VXNlcjk0MjQ3OTI=", "avatar_url": "https://avatars.githubusercontent.com/u/9424792?v=4", "gravatar_id": "", "url": "https://api.github.com/users/estebanavv", "html_url": "https://github.com/estebanavv", "followers_url": "https://api.github.com/users/estebanavv/followers", "following_url": "https://api.github.com/users/estebanavv/following{/other_user}", "gists_url": "https://api.github.com/users/estebanavv/gists{/gist_id}", "starred_url": "https://api.github.com/users/estebanavv/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/estebanavv/subscriptions", "organizations_url": "https://api.github.com/users/estebanavv/orgs", "repos_url": "https://api.github.com/users/estebanavv/repos", "events_url": "https://api.github.com/users/estebanavv/events{/privacy}", "received_events_url": "https://api.github.com/users/estebanavv/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-16T17:39:54Z", "updated_at": "2026-03-16T17:57:54Z", "body": "Just FYI, not sure if it is relevant the skill ocr-md was built by myself and hermes from scratch, attached. And the python app was also built from scratch.\n\n[SKILL.md](https://github.com/user-attachments/files/26032516/SKILL.md)\n\nI suspect that the cause was this :\n`~/.hermes/skills/.hub/index-cache/clawhub_catalog_v1.json` which is 3.5 MB not sure why this would interact with the prompt but it should not at all. \n\n```\n-rw-r--r--  1 esteban  staff    10442 Mar 15 13:47 anthropics_skills_skills_.json\n-rw-r--r--  1 esteban  staff     1089 Mar 15 13:47 claude_marketplace_anthropics_skills.json\n-rw-r--r--@ 1 esteban  staff  3597491 Mar 15 13:49 clawhub_catalog_v1.json\n-rw-r--r--  1 esteban  staff     3878 Mar 15 13:49 clawhub_search_catalog_v1_20c256806227ca9b68fecafa76538b51.json\n-rw-r--r--  1 esteban  staff    14586 Mar 15 13:55 clawhub_search_catalog_v1_ca0bceaab116c9203eaabe6b3855552a.json\n-rw-r--r--  1 esteban  staff    15436 Mar 15 13:47 clawhub_search_listing_v1_d41d8cd98f00b204e9800998ecf8427e_50.json\n-rw-r--r--  1 esteban  staff   251446 Mar 15 13:47 lobehub_index.json\n-rw-r--r--  1 esteban  staff      383 Mar 15 13:55 nousresearch_hermes-agent_skills_.json\n-rw-r--r--  1 esteban  staff        2 Mar 15 13:47 openai_skills_skills_.json\n-rw-r--r--  1 esteban  staff      748 Mar 15 13:55 skills_sh_detail_c02d700a0fb17a9798b85aae3eaac0c8.json\n-rw-r--r--  1 esteban  staff    30080 Mar 15 13:47 skills_sh_featured.json\n-rw-r--r--  1 esteban  staff     4979 Mar 15 13:48 skills_sh_search_20c256806227ca9b68fecafa76538b51.json\n-rw-r--r--  1 esteban  staff      480 Mar 15 13:55 skills_sh_search_ca0bceaab116c9203eaabe6b3855552a.json\n```", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4069467716/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4070305186", "html_url": "https://github.com/NousResearch/hermes-agent/issues/1558#issuecomment-4070305186", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/1558", "id": 4070305186, "node_id": "IC_kwDOPRF1G87ym-2i", "user": {"login": "ygd58", "id": 78954051, "node_id": "MDQ6VXNlcjc4OTU0MDUx", "avatar_url": "https://avatars.githubusercontent.com/u/78954051?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ygd58", "html_url": "https://github.com/ygd58", "followers_url": "https://api.github.com/users/ygd58/followers", "following_url": "https://api.github.com/users/ygd58/following{/other_user}", "gists_url": "https://api.github.com/users/ygd58/gists{/gist_id}", "starred_url": "https://api.github.com/users/ygd58/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ygd58/subscriptions", "organizations_url": "https://api.github.com/users/ygd58/orgs", "repos_url": "https://api.github.com/users/ygd58/repos", "events_url": "https://api.github.com/users/ygd58/events{/privacy}", "received_events_url": "https://api.github.com/users/ygd58/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-16T20:09:52Z", "updated_at": "2026-03-16T20:09:52Z", "body": "Thanks for the additional context! The 3.5MB clawhub_catalog_v1.json cache file is likely the injection source \u2014 the agent may have read skill descriptions from that catalog while searching, and one of them contained adversarial text.\n\nPR #1562 adds injection pattern detection for skill files. I'll look into whether the index-cache files also need protection.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4070305186/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4070372501", "html_url": "https://github.com/NousResearch/hermes-agent/issues/1558#issuecomment-4070372501", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/1558", "id": 4070372501, "node_id": "
[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4503658963", "html_url": "https://github.com/NousResearch/hermes-agent/issues/29539#issuecomment-4503658963", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/29539", "id": 4503658963, "node_id": "IC_kwDOPRF1G88AAAABDHBh0w", "user": {"login": "alt-glitch", "id": 52913345, "node_id": "MDQ6VXNlcjUyOTEzMzQ1", "avatar_url": "https://avatars.githubusercontent.com/u/52913345?v=4", "gravatar_id": "", "url": "https://api.github.com/users/alt-glitch", "html_url": "https://github.com/alt-glitch", "followers_url": "https://api.github.com/users/alt-glitch/followers", "following_url": "https://api.github.com/users/alt-glitch/following{/other_user}", "gists_url": "https://api.github.com/users/alt-glitch/gists{/gist_id}", "starred_url": "https://api.github.com/users/alt-glitch/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/alt-glitch/subscriptions", "organizations_url": "https://api.github.com/users/alt-glitch/orgs", "repos_url": "https://api.github.com/users/alt-glitch/repos", "events_url": "https://api.github.com/users/alt-glitch/events{/privacy}", "received_events_url": "https://api.github.com/users/alt-glitch/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-21T00:09:17Z", "updated_at": "2026-05-21T00:09:17Z", "body": "This is not a hermes-agent bug \u2014 it's how Anthropic routes billing for third-party API access. When you use a Claude API key (as opposed to OAuth), Anthropic bills it as API usage regardless of your Pro/Max subscription. \n\nRelated: #29125 (same class \u2014 Claude CLI + Pro/Max billing expectations), #15080 (OAuth + Max \u2192 HTTP 400 out of extra usage).\n\nTo use your Pro/Max subscription allowance through hermes-agent, you need to authenticate via OAuth (not an API key). See the docs updated in #17399 / #17404 for details on how OAuth routes through your subscription.\n", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4503658963/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4523621124", "html_url": "https://github.com/NousResearch/hermes-agent/issues/29539#issuecomment-4523621124", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/29539", "id": 4523621124, "node_id": "IC_kwDOPRF1G88AAAABDaD7BA", "user": {"login": "Anthony-Breneliere", "id": 6704165, "node_id": "MDQ6VXNlcjY3MDQxNjU=", "avatar_url": "https://avatars.githubusercontent.com/u/6704165?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Anthony-Breneliere", "html_url": "https://github.com/Anthony-Breneliere", "followers_url": "https://api.github.com/users/Anthony-Breneliere/followers", "following_url": "https://api.github.com/users/Anthony-Breneliere/following{/other_user}", "gists_url": "https://api.github.com/users/Anthony-Breneliere/gists{/gist_id}", "starred_url": "https://api.github.com/users/Anthony-Breneliere/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Anthony-Breneliere/subscriptions", "organizations_url": "https://api.github.com/users/Anthony-Breneliere/orgs", "repos_url": "https://api.github.com/users/Anthony-Breneliere/repos", "events_url": "https://api.github.com/users/Anthony-Breneliere/events{/privacy}", "received_events_url": "https://api.github.com/users/Anthony-Breneliere/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-23T01:01:17Z", "updated_at": "2026-05-23T01:01:17Z", "body": "> To use your Pro/Max subscription allowance through hermes-agent, you need to authenticate via OAuth (not an API key). See the docs updated in [#17399](https://github.com/NousResearch/hermes-agent/pull/17399) / [#17404](https://github.com/NousResearch/hermes-agent/pull/17404) for details on how OAuth routes through your subscription.\n\nI have credits on my anthropic account, claude plan max, it worked yesterday but not anymore.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4523621124/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4529048316", "html_url": "https://github.com/NousResearch/hermes-agent/issues/29539#issuecomment-4529048316", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/29539", "id": 4529048316, "node_id": "IC_kwDOPRF1G88AAAABDfPK_A", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-24T14:43:36Z", "updated_at": "2026-05-24T14:43:36Z", "body": "Closing \u2014 this is intended behavior from Anthropic's side, not a bug we can fix.\n\nAnthropic forces the `mcp_` tool-name prefix as the only pathway through which OAuth subscription tokens (Pro/Max) can access tools at all. The subscription-token tool access they allow is metered against the overage/extra-usage bucket exclusively \u2014 there is no \"included quota\" path for tools on OAuth subscriptions. Removing the prefix doesn't unlock the included quota; it would block all tool-bearing requests on subscription tokens entirely.\n\nThe trade-off is intentional: keep the prefix and have tools work for users who have overage enabled (or pay-per-use), or drop the prefix and break tools for every OAuth subscription user. We chose the former.\n\nFor Max/Pro subscribers without overage enabled: use an API key instead of the OAuth subscription token, or enable usage-based billing on your Anthropic account.\n\nTracking issue: #28849.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4529048316/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4637232292", "html_url": "https://github.com/NousResearch/hermes-agent/issues/6997#issuecomment-4637232292", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/6997", "id": 4637232292, "node_id": "IC_kwDOPRF1G88AAAABFGaMpA", "user": {"login": "aihoom", "id": 18644030, "node_id": "MDQ6VXNlcjE4NjQ0MDMw", "avatar_url": "https://avatars.githubusercontent.com/u/18644030?v=4", "gravatar_id": "", "url": "https://api.github.com/users/aihoom", "html_url": "https://github.com/aihoom", "followers_url": "https://api.github.com/users/aihoom/followers", "following_url": "https://api.github.com/users/aihoom/following{/other_user}", "gists_url": "https://api.github.com/users/aihoom/gists{/gist_id}", "starred_url": "https://api.github.com/users/aihoom/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/aihoom/subscriptions", "organizations_url": "https://api.github.com/users/aihoom/orgs", "repos_url": "https://api.github.com/users/aihoom/repos", "events_url": "https://api.github.com/users/aihoom/events{/privacy}", "received_events_url": "https://api.github.com/users/aihoom/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-06T03:30:09Z", "updated_at": "2026-06-06T03:30:09Z", "body": "Whose bright idea was it to add a tool-call limit? This is incredibly frustrating. The agent hits the limit after doing just one or two basic tasks. It\u2019s completely brain-dead.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4637232292/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4950772096", "html_url": "https://github.com/NousResearch/hermes-agent/issues/6997#issuecomment-4950772096", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/6997", "id": 4950772096, "node_id": "IC_kwDOPRF1G88AAAABJxbJgA", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-12T10:01:51Z", "updated_at": "2026-07-12T10:01:51Z", "body": "<!-- hermes-sweeper:item=6997 -->\n<!-- hermes-sweeper:verdict=close reason=implemented_on_main confidence=high -->\nThanks for raising the autonomy and resumability concern. This is an automated hermes-sweeper review; current `main` now documents and implements the relevant controls and continuation path.\n\n- `agent.max_turns` defaults to 90 and can be changed in config; `hermes chat --max-turns <N>` overrides it for one conversation turn (`hermes_cli/config.py:991`, `hermes_cli/_parser.py:354`).\n- On exhaustion, Hermes requests a final response without further tools rather than silently abandoning the session (`agent/turn_finalizer.py:53-70`; `agent/chat_completion_helpers.py:1576-1585`).\n- For long autonomous work, `/goal` continues across turns until completion or its configured continuation budget; it persists through `/resume` and explicitly tells the user to run `/goal resume` after that budget pauses (`website/docs/user-guide/features/goals.md:150-168`).\n- The user-facing explanation of the iteration budget and these behaviors is now in `website/docs/user-guide/configuration.md:826-851`.\n- Persistent `/goal` support was added in commit `265bd59c1d9f8dea658f243b257d4fae3685af53` (`feat: /goal \u2014 persistent cross-turn goals (Ralph loop)`).\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4950772096/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4692056637", "html_url": "https://github.com/NousResearch/hermes-agent/issues/44894#issuecomment-4692056637", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/44894", "id": 4692056637, "node_id": "IC_kwDOPRF1G88AAAABF6saPQ", "user": {"login": "alt-glitch", "id": 52913345, "node_id": "MDQ6VXNlcjUyOTEzMzQ1", "avatar_url": "https://avatars.githubusercontent.com/u/52913345?v=4", "gravatar_id": "", "url": "https://api.github.com/users/alt-glitch", "html_url": "https://github.com/alt-glitch", "followers_url": "https://api.github.com/users/alt-glitch/followers", "following_url": "https://api.github.com/users/alt-glitch/following{/other_user}", "gists_url": "https://api.github.com/users/alt-glitch/gists{/gist_id}", "starred_url": "https://api.github.com/users/alt-glitch/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/alt-glitch/subscriptions", "organizations_url": "https://api.github.com/users/alt-glitch/orgs", "repos_url": "https://api.github.com/users/alt-glitch/repos", "events_url": "https://api.github.com/users/alt-glitch/events{/privacy}", "received_events_url": "https://api.github.com/users/alt-glitch/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-12T14:11:40Z", "updated_at": "2026-06-12T14:11:40Z", "body": "Duplicate of #24029 \u2014 same root cause: `auxiliary_client.py` hardcodes `_OPENROUTER_MODEL`/`_NOUS_MODEL` to the paid `google/gemini-3-flash-preview`, so auxiliary tasks (session title generation, etc.) bill a paid OpenRouter model even when your main provider is local/free. Tracked there alongside fix discussion (#24039, #25180).", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4692056637/reactions", "total_count": 1, "+1": 0, "-1": 1, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4824001231", "html_url": "https://github.com/NousResearch/hermes-agent/issues/44894#issuecomment-4824001231", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/44894", "id": 4824001231, "node_id": "IC_kwDOPRF1G88AAAABH4hqzw", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-28T01:53:33Z", "updated_at": "2026-06-28T01:53:33Z", "body": "Fixed on `main` by PR #47235 (\"fix(auxiliary): honor fallback policy for auto tasks\", merged in commit 4858942c).\n\nYou correctly identified the root cause: `_OPENROUTER_MODEL` / `_NOUS_MODEL` (`google/gemini-3-flash-preview`) was a hardcoded auxiliary default reached whenever the main provider failed, regardless of the user's configured fallback policy.\n\n`_resolve_auto()` now consults user fallback policy **before** that hardcoded discovery chain:\n\n1. `auxiliary.<task>.fallback_chain`\n2. top-level `fallback_providers` / `fallback_model`\n3. only then the built-in `openrouter \u2192 nous \u2192 custom \u2192 api-key` discovery defaults\n\nSo for local-inference / custom-endpoint users (the exact case you described), auxiliary tasks now route through your declared fallback policy instead of jumping to the hardcoded Gemini default. Thanks for the digging and the cross-reference to #24029.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4824001231/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
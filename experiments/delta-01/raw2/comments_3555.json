[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4148664592", "html_url": "https://github.com/NousResearch/hermes-agent/issues/3555#issuecomment-4148664592", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/3555", "id": 4148664592, "node_id": "IC_kwDOPRF1G873R5kQ", "user": {"login": "paraddox", "id": 1156695, "node_id": "MDQ6VXNlcjExNTY2OTU=", "avatar_url": "https://avatars.githubusercontent.com/u/1156695?v=4", "gravatar_id": "", "url": "https://api.github.com/users/paraddox", "html_url": "https://github.com/paraddox", "followers_url": "https://api.github.com/users/paraddox/followers", "following_url": "https://api.github.com/users/paraddox/following{/other_user}", "gists_url": "https://api.github.com/users/paraddox/gists{/gist_id}", "starred_url": "https://api.github.com/users/paraddox/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/paraddox/subscriptions", "organizations_url": "https://api.github.com/users/paraddox/orgs", "repos_url": "https://api.github.com/users/paraddox/repos", "events_url": "https://api.github.com/users/paraddox/events{/privacy}", "received_events_url": "https://api.github.com/users/paraddox/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-28T19:25:38Z", "updated_at": "2026-03-28T19:25:38Z", "body": "I had a local patch for this but would be nice for it to be in main.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4148664592/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4148752507", "html_url": "https://github.com/NousResearch/hermes-agent/issues/3555#issuecomment-4148752507", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/3555", "id": 4148752507, "node_id": "IC_kwDOPRF1G873SPB7", "user": {"login": "ygd58", "id": 78954051, "node_id": "MDQ6VXNlcjc4OTU0MDUx", "avatar_url": "https://avatars.githubusercontent.com/u/78954051?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ygd58", "html_url": "https://github.com/ygd58", "followers_url": "https://api.github.com/users/ygd58/followers", "following_url": "https://api.github.com/users/ygd58/following{/other_user}", "gists_url": "https://api.github.com/users/ygd58/gists{/gist_id}", "starred_url": "https://api.github.com/users/ygd58/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ygd58/subscriptions", "organizations_url": "https://api.github.com/users/ygd58/orgs", "repos_url": "https://api.github.com/users/ygd58/repos", "events_url": "https://api.github.com/users/ygd58/events{/privacy}", "received_events_url": "https://api.github.com/users/ygd58/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-28T20:23:54Z", "updated_at": "2026-03-28T20:23:54Z", "body": "Submitted a fix in PR #3570. When a local base_url (localhost, 127.0.0.1, ::1) is detected and no API key is configured, uses \"local\" as a placeholder key at the client initialization level. This is cleaner than modifying the dataclass \u2014 the fix is applied where the URL\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\u200b\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4148752507/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4150535425", "html_url": "https://github.com/NousResearch/hermes-agent/issues/3555#issuecomment-4150535425", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/3555", "id": 4150535425, "node_id": "IC_kwDOPRF1G873ZCUB", "user": {"login": "CHesketh76", "id": 38713764, "node_id": "MDQ6VXNlcjM4NzEzNzY0", "avatar_url": "https://avatars.githubusercontent.com/u/38713764?v=4", "gravatar_id": "", "url": "https://api.github.com/users/CHesketh76", "html_url": "https://github.com/CHesketh76", "followers_url": "https://api.github.com/users/CHesketh76/followers", "following_url": "https://api.github.com/users/CHesketh76/following{/other_user}", "gists_url": "https://api.github.com/users/CHesketh76/gists{/gist_id}", "starred_url": "https://api.github.com/users/CHesketh76/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/CHesketh76/subscriptions", "organizations_url": "https://api.github.com/users/CHesketh76/orgs", "repos_url": "https://api.github.com/users/CHesketh76/repos", "events_url": "https://api.github.com/users/CHesketh76/events{/privacy}", "received_events_url": "https://api.github.com/users/CHesketh76/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-29T16:46:41Z", "updated_at": "2026-03-29T16:46:41Z", "body": "@ygd58 I just updated and I am still seeing the issue in the Hermes CLI and when I run `hermes honcho identity` it returns `Honcho connection failed: Invalid API key`\n\nHow do we tell if the Honcha even works with a local connection? When testing the CLI with some instructions it continues to forgets tools details from recent messages in the same session. The docker returns `200` codes so I am assuming it is connected, but overall it does not seem that impressive. ", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4150535425/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4150546141", "html_url": "https://github.com/NousResearch/hermes-agent/issues/3555#issuecomment-4150546141", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/3555", "id": 4150546141, "node_id": "IC_kwDOPRF1G873ZE7d", "user": {"login": "ygd58", "id": 78954051, "node_id": "MDQ6VXNlcjc4OTU0MDUx", "avatar_url": "https://avatars.githubusercontent.com/u/78954051?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ygd58", "html_url": "https://github.com/ygd58", "followers_url": "https://api.github.com/users/ygd58/followers", "following_url": "https://api.github.com/users/ygd58/following{/other_user}", "gists_url": "https://api.github.com/users/ygd58/gists{/gist_id}", "starred_url": "https://api.github.com/users/ygd58/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ygd58/subscriptions", "organizations_url": "https://api.github.com/users/ygd58/orgs", "repos_url": "https://api.github.com/users/ygd58/repos", "events_url": "https://api.github.com/users/ygd58/events{/privacy}", "received_events_url": "https://api.github.com/users/ygd58/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-29T16:50:06Z", "updated_at": "2026-03-29T16:50:06Z", "body": "\n\nAdd to ~/.hermes/.env:\nHONCHO_API_KEY=local\n\nThis gives the SDK a non-empty placeholder key. Your local server will ignore it.\n\nTo verify connection: hermes honcho status\n\nNote: Honcho is a memory layer, not a context window it won't remember tool details within the same session. It helps across sessions.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4150546141/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4163955030", "html_url": "https://github.com/NousResearch/hermes-agent/issues/3555#issuecomment-4163955030", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/3555", "id": 4163955030, "node_id": "IC_kwDOPRF1G874MOlW", "user": {"login": "Heavy-A", "id": 201243148, "node_id": "U_kgDOC_66DA", "avatar_url": "https://avatars.githubusercontent.com/u/201243148?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Heavy-A", "html_url": "https://github.com/Heavy-A", "followers_url": "https://api.github.com/users/Heavy-A/followers", "following_url": "https://api.github.com/users/Heavy-A/following{/other_user}", "gists_url": "https://api.github.com/users/Heavy-A/gists{/gist_id}", "starred_url": "https://api.github.com/users/Heavy-A/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Heavy-A/subscriptions", "organizations_url": "https://api.github.com/users/Heavy-A/orgs", "repos_url": "https://api.github.com/users/Heavy-A/repos", "events_url": "https://api.github.com/users/Heavy-A/events{/privacy}", "received_events_url": "https://api.github.com/users/Heavy-A/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-31T16:38:52Z", "updated_at": "2026-03-31T16:38:52Z", "body": "I still see that error in my local setup AND I get a reply from honcho.\nIs this because this actually is an internal error from honcho?\n\n<img width=\"1063\" height=\"583\" alt=\"Image\" src=\"https://github.com/user-attachments/assets/c8c8bcae-f83b-4644-a838-1bc35eb335c2\" />", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4163955030/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4169038453", "html_url": "https://github.com/NousResearch/hermes-agent/issues/3555#issuecomment-4169038453", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/3555", "id": 4169038453, "node_id": "IC_kwDOPRF1G874fnp1", "user": {"login": "ygd58", "id": 78954051, "node_id": "MDQ6VXNlcjc4OTU0MDUx", "avatar_url": "https://avatars.githubusercontent.com/u/78954051?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ygd58", "html_url": "https://github.com/ygd58", "followers_url": "https://api.github.com/users/ygd58/followers", "following_url": "https://api.github.com/users/ygd58/following{/other_user}", "gists_url": "https://api.github.com/users/ygd58/gists{/gist_id}", "starred_url": "https://api.github.com/users/ygd58/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ygd58/subscriptions", "organizations_url": "https://api.github.com/users/ygd58/orgs", "repos_url": "https://api.github.com/users/ygd58/repos", "events_url": "https://api.github.com/users/ygd58/events{/privacy}", "received_events_url": "https://api.github.com/users/ygd58/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-04-01T10:18:19Z", "updated_at": "2026-04-01T10:18:19Z", "body": "@Heavy-A The error \"Honcho init failed: Invalid API key\" appears during initialization but if you're still getting responses from Honcho, it may be a non-fatal warning that gets swallowed. The SDK validates the key format before connecting.\n\nThis is exactly what PR #3570 fixes \u2014 it injects \"local\" as a placeholder key when localhost is detected, preventing the validation error entirely. Until the PR is merged, add HONCHO_API_KEY=local to ~/.hermes/.env.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4169038453/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4366557885", "html_url": "https://github.com/NousResearch/hermes-agent/issues/3555#issuecomment-4366557885", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/3555", "id": 4366557885, "node_id": "IC_kwDOPRF1G88AAAABBERivQ", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-03T15:51:07Z", "updated_at": "2026-05-03T15:51:07Z", "body": "Thanks for the detailed report, @CHesketh76 \u2014 and to @ygd58, @paraddox, and @devorun for the quick follow-up and contributor PRs.\n\nThis was fixed in commit 0bd7e95df and shipped in **v2026.3.30** (2026-03-28). The combined fix:\n\n- **Relaxes all Honcho activation gates** to accept either an `api_key` **or** a `base_url` as valid credentials (so local-only configs no longer require a key to activate the plugin).\n- **Injects `\"local\"` as a placeholder API key** at SDK-client init time whenever `base_url` points to `localhost`, `127.0.0.1`, or `::1` \u2014 preventing the \"Invalid API key\" SDK validation error entirely (`plugins/memory/honcho/client.py`, lines 655\u2013669).\n\nIf you're still on v0.4.0, a `hermes update` (or pip upgrade) to v2026.3.30 or later should resolve the issue. No workaround like `HONCHO_API_KEY=local` is needed after updating.\n\n---\n*Automated hermes-sweeper review \u2014 read-only audit against current `main`.*", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4366557885/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4963653609", "html_url": "https://github.com/NousResearch/hermes-agent/issues/64020#issuecomment-4963653609", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/64020", "id": 4963653609, "node_id": "IC_kwDOPRF1G88AAAABJ9tX6Q", "user": {"login": "curiouscurrent", "id": 95173109, "node_id": "U_kgDOBaw59Q", "avatar_url": "https://avatars.githubusercontent.com/u/95173109?v=4", "gravatar_id": "", "url": "https://api.github.com/users/curiouscurrent", "html_url": "https://github.com/curiouscurrent", "followers_url": "https://api.github.com/users/curiouscurrent/followers", "following_url": "https://api.github.com/users/curiouscurrent/following{/other_user}", "gists_url": "https://api.github.com/users/curiouscurrent/gists{/gist_id}", "starred_url": "https://api.github.com/users/curiouscurrent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/curiouscurrent/subscriptions", "organizations_url": "https://api.github.com/users/curiouscurrent/orgs", "repos_url": "https://api.github.com/users/curiouscurrent/repos", "events_url": "https://api.github.com/users/curiouscurrent/events{/privacy}", "received_events_url": "https://api.github.com/users/curiouscurrent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-13T23:05:35Z", "updated_at": "2026-07-13T23:05:35Z", "body": "@teknium1 any solution ?", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4963653609/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4964427220", "html_url": "https://github.com/NousResearch/hermes-agent/issues/64020#issuecomment-4964427220", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/64020", "id": 4964427220, "node_id": "IC_kwDOPRF1G88AAAABJ-cl1A", "user": {"login": "webtecnica", "id": 75556242, "node_id": "MDQ6VXNlcjc1NTU2MjQy", "avatar_url": "https://avatars.githubusercontent.com/u/75556242?v=4", "gravatar_id": "", "url": "https://api.github.com/users/webtecnica", "html_url": "https://github.com/webtecnica", "followers_url": "https://api.github.com/users/webtecnica/followers", "following_url": "https://api.github.com/users/webtecnica/following{/other_user}", "gists_url": "https://api.github.com/users/webtecnica/gists{/gist_id}", "starred_url": "https://api.github.com/users/webtecnica/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/webtecnica/subscriptions", "organizations_url": "https://api.github.com/users/webtecnica/orgs", "repos_url": "https://api.github.com/users/webtecnica/repos", "events_url": "https://api.github.com/users/webtecnica/events{/privacy}", "received_events_url": "https://api.github.com/users/webtecnica/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-14T01:10:34Z", "updated_at": "2026-07-14T01:10:34Z", "body": "Hey @curiouscurrent \u2014 sorry you're hitting this. The card decline during free plan signup is a Stripe processing issue on the portal's side, and international debit cards from India can sometimes be rejected by Stripe's payment gateway even for $0 free plans (Stripe requires a valid chargeable card on file).\n\nHere are a few workarounds to try:\n\n**1. Try a different card type:**\n- Visa/Mastercard credit cards (not debit) tend to work more reliably with Stripe internationally\n- Some Indian RuPay cards aren't yet supported by Stripe\n- You might have better luck with a virtual USD card (e.g., from services like Payoneer, Wise, or VCC providers)\n\n**2. Check if your bank is blocking the transaction:**\n- Contact your bank and ask them to whitelist international online transactions and Stripe charges\n- Make sure international transactions are enabled on your card\n\n**3. Alternative: Use a non-Nous provider directly:**\nHermes doesn't strictly require a portal subscription. You can configure the agent entirely offline using a direct API key. After installation, run:\n```\nhermes model\n```\nThen select any provider other than \"Nous\" \u2014 e.g., **OpenAI**, **OpenRouter**, **Groq**, or another provider. These let you use Hermes without going through the portal's billing system at all.\n\nSpecifically:\n- **Groq** offers free models (Gemma, Llama, DeepSeek) with rate limits \u2014 just get a free API key at groq.com\n- **OpenRouter** gives access to many models with pay-as-you-go pricing\n\n**4. After subscribing, re-authenticate:**\nIf you do find a working card, run `hermes model` after subscribing to refresh your session.\n\nThis is ultimately a portal-side payment processing limitation. I'll flag it with the team so we can investigate whether the portal can offer additional payment options (like PayPal, UPI, or NetBanking) and/or handle free-plan signups without requiring a card on file at all.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4964427220/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4966533024", "html_url": "https://github.com/NousResearch/hermes-agent/issues/64020#issuecomment-4966533024", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/64020", "id": 4966533024, "node_id": "IC_kwDOPRF1G88AAAABKAdHoA", "user": {"login": "curiouscurrent", "id": 95173109, "node_id": "U_kgDOBaw59Q", "avatar_url": "https://avatars.githubusercontent.com/u/95173109?v=4", "gravatar_id": "", "url": "https://api.github.com/users/curiouscurrent", "html_url": "https://github.com/curiouscurrent", "followers_url": "https://api.github.com/users/curiouscurrent/followers", "following_url": "https://api.github.com/users/curiouscurrent/following{/other_user}", "gists_url": "https://api.github.com/users/curiouscurrent/gists{/gist_id}", "starred_url": "https://api.github.com/users/curiouscurrent/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/curiouscurrent/subscriptions", "organizations_url": "https://api.github.com/users/curiouscurrent/orgs", "repos_url": "https://api.github.com/users/curiouscurrent/repos", "events_url": "https://api.github.com/users/curiouscurrent/events{/privacy}", "received_events_url": "https://api.github.com/users/curiouscurrent/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-14T07:36:24Z", "updated_at": "2026-07-14T07:36:24Z", "body": "Hi @webtecnica , unfortunately I don't have a credit card. But thankyou for letting me know the alternative approach, will do it. Thankyou for helping.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4966533024/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
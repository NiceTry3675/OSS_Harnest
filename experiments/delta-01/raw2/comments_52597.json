[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4803737109", "html_url": "https://github.com/NousResearch/hermes-agent/issues/52597#issuecomment-4803737109", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/52597", "id": 4803737109, "node_id": "IC_kwDOPRF1G88AAAABHlM2FQ", "user": {"login": "ron-1986", "id": 16613763, "node_id": "MDQ6VXNlcjE2NjEzNzYz", "avatar_url": "https://avatars.githubusercontent.com/u/16613763?v=4", "gravatar_id": "", "url": "https://api.github.com/users/ron-1986", "html_url": "https://github.com/ron-1986", "followers_url": "https://api.github.com/users/ron-1986/followers", "following_url": "https://api.github.com/users/ron-1986/following{/other_user}", "gists_url": "https://api.github.com/users/ron-1986/gists{/gist_id}", "starred_url": "https://api.github.com/users/ron-1986/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/ron-1986/subscriptions", "organizations_url": "https://api.github.com/users/ron-1986/orgs", "repos_url": "https://api.github.com/users/ron-1986/repos", "events_url": "https://api.github.com/users/ron-1986/events{/privacy}", "received_events_url": "https://api.github.com/users/ron-1986/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-25T20:09:41Z", "updated_at": "2026-06-25T20:09:41Z", "body": "I found a very quick and dirty solution to work around the problem.\nRemoving read and execute permissions from .hermes/hermes-agent/tools/web_tools.py makes it impossible to load the toolset for hermes.\nTools are not available in sessions afterwards.\n\nAnyway, a way to configure this cleanly would be great.\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4803737109/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4976590438", "html_url": "https://github.com/NousResearch/hermes-agent/issues/52597#issuecomment-4976590438", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/52597", "id": 4976590438, "node_id": "IC_kwDOPRF1G88AAAABKKC-Zg", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-15T03:32:17Z", "updated_at": "2026-07-15T03:32:17Z", "body": "<!-- hermes-sweeper:item=52597 -->\n<!-- hermes-sweeper:verdict=close reason=implemented_on_main confidence=high -->\nThis is implemented on current `main`; thanks for the concrete Matrix configuration report. This is an automated hermes-sweeper review.\n\n- Matrix is a supported per-platform toolset target: `hermes_cli/platforms.py:33` maps it to `hermes-matrix`.\n- Gateway sessions resolve `platform_toolsets.matrix` and pass that result to `AIAgent` as `enabled_toolsets` (`gateway/run.py:17041-17047`).\n- `hermes_cli/tools_config.py:1646-1682` treats an explicit list of configurable toolsets as the platform allowlist.\n- The supplied example still includes `browser`; `browser` intentionally includes `web_search` (`toolsets.py:172-181`). Remove both `web` and `browser` to omit built-in `web_search` and `web_extract`.\n- Matrix platform toolset support shipped in `ba3bbf5b537610b9d8beec3a79b050f54abeb393` (`fix: add missing mattermost/matrix/dingtalk toolsets + platform consistency tests`), contained in `v2026.3.30`.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4976590438/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
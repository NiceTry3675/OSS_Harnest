[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4119984417", "html_url": "https://github.com/NousResearch/hermes-agent/issues/2825#issuecomment-4119984417", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/2825", "id": 4119984417, "node_id": "IC_kwDOPRF1G871kfkh", "user": {"login": "Mibayy", "id": 97958526, "node_id": "U_kgDOBda6fg", "avatar_url": "https://avatars.githubusercontent.com/u/97958526?v=4", "gravatar_id": "", "url": "https://api.github.com/users/Mibayy", "html_url": "https://github.com/Mibayy", "followers_url": "https://api.github.com/users/Mibayy/followers", "following_url": "https://api.github.com/users/Mibayy/following{/other_user}", "gists_url": "https://api.github.com/users/Mibayy/gists{/gist_id}", "starred_url": "https://api.github.com/users/Mibayy/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/Mibayy/subscriptions", "organizations_url": "https://api.github.com/users/Mibayy/orgs", "repos_url": "https://api.github.com/users/Mibayy/repos", "events_url": "https://api.github.com/users/Mibayy/events{/privacy}", "received_events_url": "https://api.github.com/users/Mibayy/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-24T17:18:16Z", "updated_at": "2026-03-24T17:18:16Z", "body": "Hi @VictorR29,\n\nThis is a known issue with `uv` inside proot environments on aarch64 (Termux). The problem is that `uv` creates a temp file and tries to rename/move it atomically, but proot doesn't fully support cross-directory atomic file operations, so the temp path disappears mid-copy.\n\n**Fix:**\n\n```bash\nexport UV_LINK_MODE=copy\nexport TMPDIR=$HOME/tmp\nmkdir -p $HOME/tmp\n```\n\nThen re-run the install:\n\n```bash\ncd ~/.hermes/hermes-agent && uv pip install -e '.[all]'\n```\n\nSetting `UV_LINK_MODE=copy` disables the hardlink/rename strategy entirely and forces a plain file copy, which proot handles fine. Setting `TMPDIR` to a path inside your home keeps temp files on the same filesystem as the target, which avoids the cross-mount issue.\n\nIf the error persists, you can also try falling back to pip directly:\n\n```bash\npip install -e '.[all]'\n```\n\nLet us know if that resolves it.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4119984417/reactions", "total_count": 1, "+1": 1, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4120213081", "html_url": "https://github.com/NousResearch/hermes-agent/issues/2825#issuecomment-4120213081", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/2825", "id": 4120213081, "node_id": "IC_kwDOPRF1G871lXZZ", "user": {"login": "VictorR29", "id": 54075687, "node_id": "MDQ6VXNlcjU0MDc1Njg3", "avatar_url": "https://avatars.githubusercontent.com/u/54075687?v=4", "gravatar_id": "", "url": "https://api.github.com/users/VictorR29", "html_url": "https://github.com/VictorR29", "followers_url": "https://api.github.com/users/VictorR29/followers", "following_url": "https://api.github.com/users/VictorR29/following{/other_user}", "gists_url": "https://api.github.com/users/VictorR29/gists{/gist_id}", "starred_url": "https://api.github.com/users/VictorR29/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/VictorR29/subscriptions", "organizations_url": "https://api.github.com/users/VictorR29/orgs", "repos_url": "https://api.github.com/users/VictorR29/repos", "events_url": "https://api.github.com/users/VictorR29/events{/privacy}", "received_events_url": "https://api.github.com/users/VictorR29/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-03-24T17:46:33Z", "updated_at": "2026-03-24T17:55:05Z", "body": "La instalaci\u00f3n se llev\u00f3 a cabo sin errores.\n\nPero despu\u00e9s de escribir source ~/.zshrc y luego hermes, aparece este error\n\nzsh: command not found: hermes\n\n\nls -l /root/.hermes/hermes-agent/venv/bin/hermes\n\nls: cannot access '/root/.hermes/hermes-agent/venv/bin/hermes': No such file or directory", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4120213081/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
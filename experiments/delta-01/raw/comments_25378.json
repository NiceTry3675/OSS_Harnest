[{"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4447060941", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25378#issuecomment-4447060941", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25378", "id": 4447060941, "node_id": "IC_kwDOPRF1G88AAAABCRDDzQ", "user": {"login": "alt-glitch", "id": 52913345, "node_id": "MDQ6VXNlcjUyOTEzMzQ1", "avatar_url": "https://avatars.githubusercontent.com/u/52913345?v=4", "gravatar_id": "", "url": "https://api.github.com/users/alt-glitch", "html_url": "https://github.com/alt-glitch", "followers_url": "https://api.github.com/users/alt-glitch/followers", "following_url": "https://api.github.com/users/alt-glitch/following{/other_user}", "gists_url": "https://api.github.com/users/alt-glitch/gists{/gist_id}", "starred_url": "https://api.github.com/users/alt-glitch/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/alt-glitch/subscriptions", "organizations_url": "https://api.github.com/users/alt-glitch/orgs", "repos_url": "https://api.github.com/users/alt-glitch/repos", "events_url": "https://api.github.com/users/alt-glitch/events{/privacy}", "received_events_url": "https://api.github.com/users/alt-glitch/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-14T02:57:36Z", "updated_at": "2026-05-14T02:57:36Z", "body": "Likely user configuration issue: the endpoint URL shows `gpt5.4` as the deployment name but the model is `gpt-5.4` \u2014 Azure deployment names are case/punctuation-sensitive and must exactly match what's configured in Azure Portal. The 404 means the deployment was not found at that endpoint.\n\nRelated Azure OpenAI issues: #9705 (stream_options.include_usage rejection), #22343 (api_mode routing), #20450 (context override). See also closed #6598 for a similar 404 setup issue.\n", "author_association": "COLLABORATOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4447060941/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4456192631", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25378#issuecomment-4456192631", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25378", "id": 4456192631, "node_id": "IC_kwDOPRF1G88AAAABCZwadw", "user": {"login": "hmishra-cv", "id": 214876136, "node_id": "U_kgDODM6_6A", "avatar_url": "https://avatars.githubusercontent.com/u/214876136?v=4", "gravatar_id": "", "url": "https://api.github.com/users/hmishra-cv", "html_url": "https://github.com/hmishra-cv", "followers_url": "https://api.github.com/users/hmishra-cv/followers", "following_url": "https://api.github.com/users/hmishra-cv/following{/other_user}", "gists_url": "https://api.github.com/users/hmishra-cv/gists{/gist_id}", "starred_url": "https://api.github.com/users/hmishra-cv/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/hmishra-cv/subscriptions", "organizations_url": "https://api.github.com/users/hmishra-cv/orgs", "repos_url": "https://api.github.com/users/hmishra-cv/repos", "events_url": "https://api.github.com/users/hmishra-cv/events{/privacy}", "received_events_url": "https://api.github.com/users/hmishra-cv/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-15T01:50:39Z", "updated_at": "2026-05-15T01:51:20Z", "body": "Thanks. It is working and this issue should be closed.", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4456192631/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4526733098", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25378#issuecomment-4526733098", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25378", "id": 4526733098, "node_id": "IC_kwDOPRF1G88AAAABDdB3Kg", "user": {"login": "promptnpray", "id": 264709058, "node_id": "U_kgDOD8cjwg", "avatar_url": "https://avatars.githubusercontent.com/u/264709058?v=4", "gravatar_id": "", "url": "https://api.github.com/users/promptnpray", "html_url": "https://github.com/promptnpray", "followers_url": "https://api.github.com/users/promptnpray/followers", "following_url": "https://api.github.com/users/promptnpray/following{/other_user}", "gists_url": "https://api.github.com/users/promptnpray/gists{/gist_id}", "starred_url": "https://api.github.com/users/promptnpray/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/promptnpray/subscriptions", "organizations_url": "https://api.github.com/users/promptnpray/orgs", "repos_url": "https://api.github.com/users/promptnpray/repos", "events_url": "https://api.github.com/users/promptnpray/events{/privacy}", "received_events_url": "https://api.github.com/users/promptnpray/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-05-23T22:49:44Z", "updated_at": "2026-05-23T22:49:44Z", "body": "it is not working.  these kinda calls require an api version parameter, e.g. api-version=2025-01-01-preview, but hermes agent is cutting off the api version part when using it in the API endpoint URL.  please fix this ", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4526733098/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4688047821", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25378#issuecomment-4688047821", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25378", "id": 4688047821, "node_id": "IC_kwDOPRF1G88AAAABF23uzQ", "user": {"login": "teknium1", "id": 127238744, "node_id": "U_kgDOB5WCWA", "avatar_url": "https://avatars.githubusercontent.com/u/127238744?v=4", "gravatar_id": "", "url": "https://api.github.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-12T06:22:11Z", "updated_at": "2026-06-12T06:22:11Z", "body": "<!-- hermes-sweeper:item=25378 -->\n<!-- hermes-sweeper:verdict=close reason=implemented_on_main confidence=high -->\nThis looks implemented on current `main` now.\n\nAutomated hermes-sweeper review evidence:\n\n- The original reporter confirmed the setup was working and said the issue should be closed.\n- The later follow-up said Azure calls need `api-version` and Hermes was cutting that query parameter off.\n- Current `main` preserves query parameters from explicit/custom base URLs by moving them into the OpenAI SDK `default_query`, so SDK path joining no longer drops `api-version`:\n  - `agent/agent_init.py:728` extracts Azure-style query params from `base_url` and passes them as `client_kwargs[\"default_query\"]`.\n  - `agent/auxiliary_client.py:118` defines the shared query extraction helper.\n  - `agent/auxiliary_client.py:3585` applies that helper to custom endpoints and passes `default_query` through.\n- The Azure guide documents the supported legacy form: `https://<resource>.openai.azure.com/openai?api-version=2025-04-01-preview` at `website/docs/guides/azure-foundry.md:230`.\n\nThis shipped on main in/through `9f408989c4` and is contained in release `v2026.5.28` and later.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4688047821/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4813445385", "html_url": "https://github.com/NousResearch/hermes-agent/issues/25378#issuecomment-4813445385", "issue_url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/25378", "id": 4813445385, "node_id": "IC_kwDOPRF1G88AAAABHudZCQ", "user": {"login": "DavidMetcalfe", "id": 80915, "node_id": "MDQ6VXNlcjgwOTE1", "avatar_url": "https://avatars.githubusercontent.com/u/80915?v=4", "gravatar_id": "", "url": "https://api.github.com/users/DavidMetcalfe", "html_url": "https://github.com/DavidMetcalfe", "followers_url": "https://api.github.com/users/DavidMetcalfe/followers", "following_url": "https://api.github.com/users/DavidMetcalfe/following{/other_user}", "gists_url": "https://api.github.com/users/DavidMetcalfe/gists{/gist_id}", "starred_url": "https://api.github.com/users/DavidMetcalfe/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/DavidMetcalfe/subscriptions", "organizations_url": "https://api.github.com/users/DavidMetcalfe/orgs", "repos_url": "https://api.github.com/users/DavidMetcalfe/repos", "events_url": "https://api.github.com/users/DavidMetcalfe/events{/privacy}", "received_events_url": "https://api.github.com/users/DavidMetcalfe/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-06-26T21:06:49Z", "updated_at": "2026-06-26T21:06:49Z", "body": "The related `stream_options.include_usage` issue (#9705) that was linked from this thread has been addressed in PR #53271. That fix auto-detects and caches endpoint incompatibility with stream_options, retrying without it. Separate from the query-parameter fix that was already shipped in v2026.5.28+.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/comments/4813445385/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]
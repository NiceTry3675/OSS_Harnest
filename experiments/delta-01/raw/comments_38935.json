ub.com/users/teknium1", "html_url": "https://github.com/teknium1", "followers_url": "https://api.github.com/users/teknium1/followers", "following_url": "https://api.github.com/users/teknium1/following{/other_user}", "gists_url": "https://api.github.com/users/teknium1/gists{/gist_id}", "starred_url": "https://api.github.com/users/teknium1/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/teknium1/subscriptions", "organizations_url": "https://api.github.com/users/teknium1/orgs", "repos_url": "https://api.github.com/users/teknium1/repos", "events_url": "https://api.github.com/users/teknium1/events{/privacy}", "received_events_url": "https://api.github.com/users/teknium1/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2026-07-14T00:51:52Z", "updated_at": "2026-07-14T00:51:52Z", "body": "<!-- hermes-sweeper:item=38935 -->\n<!-- hermes-sweeper:verdict=close reason=implemented_on_main confidence=high -->\nThis is an automated hermes-sweeper review. Current `main` supports a custom Windows installation location.\n\n- `website/docs/user-guide/windows-native.md:28-42` documents the PowerShell scriptblock form and both path parameters.\n- For example, install both data and runtime outside the system drive with:\n  `& ([scriptblock]::Create((irm https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.ps1))) -HermesHome 'D:\\Hermes' -InstallDir 'D:\\Hermes\\hermes-agent'`\n- `scripts/install.ps1:15-27` defines those overrides, and `scripts/install.ps1:2080-2088` persists the selected `HERMES_HOME` for subsequent launches.\n- The packaged Desktop installer also permits choosing its installation directory (`apps/desktop/package.json:255-262`).\n\nThe later comments reporting no durable workaround predate the current documented override path.\n", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/NousResearch/hermes-agent/issues/com